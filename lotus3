sub _sdm_pretty_value {
	my ($value) = @_;
	return "" unless defined $value;
	$value =~ s/^\s+|\s+$//g;
	return lc($value) if $value =~ /^n\/a$/i;
	if ($value =~ /^([\d,]+)(.*)$/) {
		my ($count, $suffix) = ($1, $2);
		$count =~ s/,//g;
		$count = reverse $count;
		$count =~ s/(\d{3})(?=\d)/$1,/g;
		$count = reverse $count;
		return $count . $suffix;
	}
	return $value;
}

sub _sdm_value_count {
	my ($value) = @_;
	return 0 unless defined $value;
	my ($count) = $value =~ /^([\d,]+)/;
	return 0 unless defined $count;
	$count =~ s/,//g;
	return 0 + $count;
}

sub _sdm_extract_values {
	my ($text) = @_;
	return () unless defined $text;
	my @values = $text =~ /((?:\d[\d,]*|n\/a)(?:\s*\([^)]*\))?)/ig;
	return map { _sdm_pretty_value($_) } @values;
}

sub _sdm_metric_line {
	my ($label, $values) = @_;
	return "" unless defined($values) && ref($values) eq "ARRAY" && @$values;
	return "$label: $values->[0]" if @$values == 1;
	my @parts;
	for (my $i = 0; $i < @$values; $i++) {
		push @parts, "R" . ($i + 1) . " $values->[$i]";
	}
	return "$label: " . join("; ", @parts);
}

sub parse_sdm_short_report {
	my ($sdm_text, $derep_text) = @_;
	$sdm_text //= "";
	$derep_text //= "";
	my %metrics;
	my @warnings;
	my $merged_line = "";

	for my $line (split /\r?\n/, $sdm_text) {
		$line =~ s/^\s+|\s+$//g;
		next if $line eq "";
		if ($line =~ /^merged reads:\s*([\d,]+)\s*\/\s*([\d,]+)\s*(\([^)]*\))?/i) {
			my ($merged, $total, $percent) = (_sdm_pretty_value($1), _sdm_pretty_value($2), $3 // "");
			$merged_line = "Merged reads: $merged / $total" . ($percent ne "" ? " $percent" : "");
			next;
		}
		if ($line =~ /^WARNING:\s*(Primer variant.*)/i) {
			my $warning = $1;
			$warning =~ s/\s+/ /g;
			push @warnings, "Warning: $warning";
			next;
		}
		next unless $line =~ /^([^:]+):\s*(.+)$/;
		my ($label, $values_text) = ($1, $2);
		$label =~ s/\s+/ /g;
		$label = lc($label);
		my @values = _sdm_extract_values($values_text);
		next unless @values;
		if ($label eq "reads processed") {
			$metrics{processed} = \@values;
		} elsif ($label eq "rejected") {
			$metrics{rejected} = \@values;
		} elsif ($label =~ /^accepted \(high qual(?:ity)?\)$/) {
			$metrics{accepted_high} = \@values;
		} elsif ($label =~ /^accepted \(mid qual(?:ity)?\)$/) {
			$metrics{accepted_mid} = \@values;
		} elsif ($label eq "recovered singleton reads") {
			$metrics{singletons} = \@values;
		} elsif ($label eq "low-quality reads recovered (dereplication)") {
			$metrics{low_quality_recovered} = \@values;
		} elsif ($label eq "minimum pairs with both reads accepted") {
			$metrics{accepted_pairs} = \@values;
		}
	}

	my @report;
	if ($metrics{processed}) {
		my @processed = @{$metrics{processed}};
		if (@processed == 2 && _sdm_value_count($processed[0]) == _sdm_value_count($processed[1])) {
			push @report, "Read pairs processed: $processed[0]";
		} else {
			push @report, _sdm_metric_line("Reads processed", $metrics{processed});
		}
	}
	push @report, _sdm_metric_line("High-quality", $metrics{accepted_high}) if $metrics{accepted_high};
	if ($metrics{accepted_mid} && grep { _sdm_value_count($_) > 0 } @{$metrics{accepted_mid}}) {
		push @report, _sdm_metric_line("Mid-quality", $metrics{accepted_mid});
	}
	push @report, _sdm_metric_line("Rejected", $metrics{rejected}) if $metrics{rejected};
	if ($metrics{accepted_pairs} && @{$metrics{accepted_pairs}}) {
		push @report, "Pairs accepted on both ends: $metrics{accepted_pairs}->[0]";
	}
	push @report, $merged_line if $merged_line ne "";
	if ($metrics{singletons} && grep { _sdm_value_count($_) > 0 } @{$metrics{singletons}}) {
		push @report, _sdm_metric_line("Recovered singletons", $metrics{singletons});
	}
	if ($metrics{low_quality_recovered} && grep { _sdm_value_count($_) > 0 } @{$metrics{low_quality_recovered}}) {
		push @report, _sdm_metric_line("Low-quality reads recovered", $metrics{low_quality_recovered});
	}

	my @derep_rows;
	for my $line (split /\r?\n/, $derep_text) {
		$line =~ s/^\s+|\s+$//g;
		$line =~ s/\s+/ /g;
		if ($line =~ /Dereplication:\s*([\d,]+)\s+unique sequences\s*\(avg(?:erage)? size\s+([\d.]+);\s*([\d,]+)\s+counts(?:,\s*([\d,]+)\s+merged)?\s*\)/i) {
			push @derep_rows, [map { defined($_) ? _sdm_pretty_value($_) : "" } ($1, $2, $3, $4)];
		}
	}
	for (my $i = 0; $i < @derep_rows; $i++) {
		my ($unique, $average, $counts, $merged) = @{$derep_rows[$i]};
		my $label = @derep_rows > 1 ? "Dereplication block " . ($i + 1) : "Dereplication";
		push @report, "$label: $unique unique sequences from $counts reads";
		my $detail = "  Mean abundance: $average";
		$detail .= "; merged: $merged" if defined($merged) && $merged ne "";
		push @report, $detail;
	}
	push @report, @warnings;
	push @report, "SDM completed; no recognized summary fields were found" unless @report;
	return join("\n", grep { defined($_) && $_ ne "" } @report);
}


