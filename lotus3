    $profilePreset = $p;
}

sub validate_output_directory_compatibility {
    my ($dir, $will_reset) = @_;
    return unless defined $dir && $dir ne "" && -d $dir;
    opendir my $dh, $dir or die "Cannot inspect output directory $dir: $!\n";
    my @entries = grep { $_ ne "." && $_ ne ".." } readdir($dh);
    closedir $dh;
    return unless @entries;
    my $has_owner_marker = -s File::Spec->catfile($dir, ".lotus3_created_by_this_run");
    my $has_lotus_log = -s File::Spec->catfile($dir, "LotuSLogS", "LotuS_run.log");
    my $has_schema = -s File::Spec->catfile($dir, "LotuS_output_schema_version.txt");
    my $has_known_outputs = -e File::Spec->catfile($dir, "OTU.txt") || -e File::Spec->catfile($dir, "OTU.fna") || -e File::Spec->catfile($dir, "OTU.biom");
    if ($will_reset && !$has_owner_marker && !$has_schema && !($has_lotus_log && $has_known_outputs)) {
        my $msg = "Output directory '$dir' already exists and contains files, but does not look like a LotuS output directory. Refusing to delete a potentially unrelated directory. Choose an empty -o directory or remove it manually.\n";
        die $msg;
    }
}

sub validate_dry_run_output_target {
    my ($target) = @_;
    die "Dry-run output target is undefined\n" unless defined($target) && $target ne "";
    die "Dry-run output target must not be a symbolic link: $target\n" if -l $target;
    die "Dry-run output target exists but is not a directory: $target\n" if -e $target && !-d $target;

    my $absolute = -e $target ? (abs_path($target) // $target) : File::Spec->rel2abs($target);
    die "Unsafe output target for dry-run: $absolute\n"
        if $absolute eq "/" || $absolute eq "." || $absolute eq ".." || length($absolute) < 8;
    my $cwd = abs_path(".") // File::Spec->rel2abs(".");
    my $script_root = abs_path($RealBin) // File::Spec->rel2abs($RealBin);
    my $home = defined($ENV{HOME}) && $ENV{HOME} ne "" ? (abs_path($ENV{HOME}) // File::Spec->rel2abs($ENV{HOME})) : "";
    die "Unsafe output target for dry-run: a real run must not reset the current working directory or one of its parents ($absolute)\n"
        if $cwd eq $absolute || index($cwd . "/", $absolute . "/") == 0;
    die "Unsafe output target for dry-run: a real run must not reset the LotuS installation directory or one of its parents ($absolute)\n"
        if $script_root eq $absolute || index($script_root . "/", $absolute . "/") == 0;
    die "Unsafe output target for dry-run: a real run must not reset the home directory ($absolute)\n"
        if $home ne "" && $home eq $absolute;

    my $would_reset = ($TaxOnly eq "0" && $exec == 0 && $onlyTaxRedo == 0) ? 1 : 0;
    validate_output_directory_compatibility($target, $would_reset) if -d $target;
    if ($TaxOnly ne "0" && -f $TaxOnly && -d $target) {
        opendir my $tod, $target or die "Cannot inspect taxonomy-only output directory $target: $!\n";
        my @existing = grep { $_ ne "." && $_ ne ".." } readdir($tod);
        closedir $tod;
        die "Taxonomy-only output directory already contains files; the real run would refuse to overwrite it: $target\n" if @existing;
    }

    my $ancestor = dirname($absolute);
    while (!-e $ancestor) {
        my $parent = dirname($ancestor);
        last if !defined($parent) || $parent eq $ancestor;
        $ancestor = $parent;
    }
    die "Cannot determine an existing parent directory for output target $target\n" unless -d $ancestor;
    die "Output target parent is not writable: $ancestor\n" unless -w $ancestor;
}

sub _open_maybe_gzip {
    my ($file) = @_;
    return undef unless defined $file && $file ne "" && -f $file;
    my $fh;
    if ($file =~ /\.gz$/i) {
        $fh = IO::Uncompress::Gunzip->new($file, MultiStream => 1);
        return undef unless $fh;
    }
    else { open($fh, "<", $file) or return undef; }
    return $fh;
}

sub _normalized_fastq_id {
    my ($header) = @_;
    return "" unless defined $header;
    $header =~ s/^[@+]//;
    my ($id) = split(/\s+/, $header, 2);
    $id //= "";
    $id =~ s{/([12])$}{};
    return $id;
}

sub fastq_validation_scan {
    my ($file, $max_records) = @_;
    $max_records ||= 5000;
    my @problems; my @warnings; my %seen; my @ids; my $records = 0;
    my $fh = _open_maybe_gzip($file);
    return (0, ["Cannot open FASTQ file for validation: $file" . ($file =~ /\.gz$/i ? " ($GunzipError)" : "")], [], []) unless $fh;
    while ($records < $max_records) {
        my $h = <$fh>; last unless defined $h;
        my $seq = <$fh>; my $plus = <$fh>; my $qual = <$fh>;
        $records++;
        if (!defined($seq) || !defined($plus) || !defined($qual)) { push @problems, "Truncated FASTQ record $records in $file"; last; }
        s/[\r\n]+$// for ($h,$seq,$plus,$qual);
        push @problems, "Malformed FASTQ header at record $records in $file" unless $h =~ /^\@\S+/;
        push @problems, "Malformed FASTQ plus-line at record $records in $file" unless $plus =~ /^\+/;
        push @problems, "Empty FASTQ sequence at record $records in $file" if $seq eq "";
        push @problems, "Whitespace in FASTQ sequence at record $records in $file" if $seq =~ /\s/;
        push @problems, "Non-IUPAC base in FASTQ sequence at record $records in $file" if $seq =~ /[^ACGTRYSWKMBDHVNUIacgtryswkmbdhvnui.-]/;
        push @problems, "FASTQ sequence/quality length mismatch at record $records in $file" unless length($seq) == length($qual);
        push @problems, "Invalid FASTQ quality character (expected ASCII 33-126) at record $records in $file"
            if grep { $_ < 33 || $_ > 126 } unpack("C*", $qual);
        my $id = _normalized_fastq_id($h);
        if ($id ne "") {
            push @ids, $id;
            if ($seen{$id}++) { push @problems, "Duplicate FASTQ ID observed in first $records records of $file: $id"; }
            if ($plus ne "+") {
                my $plus_id = _normalized_fastq_id($plus);
                push @problems, "FASTQ plus-line ID does not match header at record $records in $file"
                    if $plus_id ne "" && $plus_id ne $id;
            }
        }
        last if @problems >= 10;
    }
    push @problems, "Error while closing/reading FASTQ file $file" unless close $fh;
    push @problems, "No FASTQ records found in $file" if $records == 0;
    return ($records, \@problems, \@warnings, \@ids);
}

sub validate_fastq_pair {
    my ($r1, $r2, $label, $max_records) = @_;
    $label //= "$r1 / $r2";
    $max_records ||= 5000;
    my ($n1,$p1,$w1,$ids1) = fastq_validation_scan($r1, $max_records);
    my ($n2,$p2,$w2,$ids2) = fastq_validation_scan($r2, $max_records);
    my @problems = (@$p1, @$p2);
    my @warnings = (@$w1, @$w2);
    push @problems, "Paired-end validation failed for $label: first $n1 R1 records but $n2 R2 records in approximate scan" if $n1 != $n2;
    my $pair_n = @$ids1 < @$ids2 ? @$ids1 : @$ids2;
    for (my $i = 0; $i < $pair_n; $i++) {
        if ($ids1->[$i] ne $ids2->[$i]) {
            push @problems, "Paired-end validation failed for $label at record " . ($i + 1) . ": R1 ID '$ids1->[$i]' does not match R2 ID '$ids2->[$i]'";
            last;
        }
    }
    return (\@problems, \@warnings);
}

sub fasta_validation_scan {
    my ($file, $max_records) = @_;
    $max_records ||= 5000;
    my @problems; my @warnings; my %seen; my @ids; my $records = 0; my $current = ""; my $saw_seq = 0;
    my $fh = _open_maybe_gzip($file);
    return (0, ["Cannot open FASTA file for validation: $file" . ($file =~ /\.gz$/i ? " ($GunzipError)" : "")], [], []) unless $fh;
    while (my $line = <$fh>) {
        $line =~ s/[\r\n]+$//;
        if ($line =~ /^>(\S+)/) {
            push @problems, "FASTA entry '$current' has no sequence in $file" if $current ne "" && !$saw_seq;
            if ($records >= $max_records) { $current = ""; last; }
            $current = $1; $saw_seq = 0; $records++; push @ids, $current;
            if ($seen{$current}++) { push @problems, "Duplicate FASTA ID observed in $file: $current"; }
        } elsif ($current ne "" && $line =~ /\S/) {
            $saw_seq = 1;
            push @problems, "Whitespace in FASTA sequence for $current in $file" if $line =~ /\s/;
            push @problems, "Non-IUPAC base in FASTA sequence for $current in $file" if $line =~ /[^ACGTRYSWKMBDHVNUIacgtryswkmbdhvnui.-]/;
        } elsif ($current eq "" && $line =~ /\S/) {
            push @problems, "FASTA content before first header in $file";
        }
        last if @problems >= 10;
    }
    push @problems, "Error while closing/reading FASTA file $file" unless close $fh;
    push @problems, "FASTA entry '$current' has no sequence in $file" if $current ne "" && !$saw_seq;
    push @problems, "No FASTA entries found in $file" if $records == 0;
    return ($records, \@problems, \@warnings, \@ids);
}

sub taxonomy_validation_scan {
    my ($file, $max_records) = @_;
    $max_records ||= 1000;
    my @problems; my @warnings; my %seen; my $records = 0;
    open my $fh, "<", $file or return (0, ["Cannot open taxonomy file for validation: $file"], []);
    while (my $line = <$fh>) {
        $line =~ s/[\r\n]+$//;
        next if $line =~ /^\s*$/;
        $records++;
        my @fields = split(/\t/, $line, -1);
        if (@fields < 2) {
            push @problems, "Taxonomy line $records in $file is not tab-separated";
        } else {
            my $id = $fields[0];
            push @problems, "Empty taxonomy ID at record $records in $file" if $id eq "";
            push @problems, "Duplicate taxonomy ID '$id' in the first $records records of $file" if $id ne "" && $seen{$id}++;
            my $taxonomy = join("\t", @fields[1..$#fields]);
            push @problems, "Empty taxonomy annotation for '$id' in $file" if $taxonomy !~ /\S/;
            push @warnings, "Control character in taxonomy annotation for '$id' in $file" if $taxonomy =~ /[\x00-\x08\x0B\x0C\x0E-\x1F]/;
        }
        last if $records >= $max_records || @problems >= 10;
    }
    close $fh or push @problems, "Error reading taxonomy file $file";
    push @problems, "No taxonomy records found in $file" if $records == 0;
    return ($records, \@problems, \@warnings);
}

sub _collect_input_files_for_validation {
    my ($map_href) = @_;
    my @files;
    my @direct = grep { defined($_) && $_ ne "" } @inputArray;
    if (@direct == 1 && -d $direct[0]) {
        opendir my $dh, $direct[0] or return @files;
        @files = map { File::Spec->catfile($direct[0], $_) }
                 grep { /\.(?:f(?:ast)?q|fna|fa|fasta)(?:\.[A-Za-z0-9_-]+)*(?:\.gz)?$/i } readdir($dh);
        closedir $dh;
    } else {
        @files = grep { -f $_ } @direct;
    }
    return @files;
}

sub _minimum_input_file_issues {
    my ($file) = @_;
    return ("path is empty") unless defined($file) && $file ne "";
    return ("does not exist") unless -e $file;
    return ("is not a regular file") unless -f $file;
    my @issues;
    push @issues, "is not readable" unless -r $file;
    push @issues, "is empty" unless -s $file;
    return @issues;
}

sub validate_inputs_before_execution {
    my ($map_href, $comb_href) = @_;
    my @problems; my @warnings;
    my @files = _collect_input_files_for_validation($map_href);
    if (!@files && defined($input) && $input ne "" && !-d $input) {
        push @problems, "No readable input FASTA/FASTQ files found from -i $input";
    }
    if (@inputArray == 1 && -d $inputArray[0]) {
        push @problems, "Input directory is not readable: $inputArray[0]" unless -r $inputArray[0];
        push @problems, "No FASTA/FASTQ files found in input directory: $inputArray[0]" unless @files;
        # Avoid stat'ing an arbitrarily large directory twice; sdm validates every file it consumes.
        for my $f (@files[0 .. ($#files < 9 ? $#files : 9)]) {
            push @problems, "Input sequence file '$f' $_" for _minimum_input_file_issues($f);
        }
    } else {
        for my $f (@inputArray) {
            push @problems, "Input sequence file '$f' $_" for _minimum_input_file_issues($f);
        }
    }

    if ($map_href && ref($map_href) eq 'HASH') {
        my %samples = map { $_ => 1 } grep { $_ ne '#SampleID' } keys %$map_href;
        for my $s (keys %samples) {
            if ($s =~ /[^A-Za-z0-9_.]/) { push @problems, "Mapping SampleID '$s' contains unsupported characters; use letters, numbers, underscore or dot"; }
        }

        my @hdr = exists($map_href->{'#SampleID'}) ? @{$map_href->{'#SampleID'}} : ();
        my $seq_col = -1;
        for (my $i=0; $i<@hdr; $i++) {
            if ($hdr[$i] eq 'fastqFile' || $hdr[$i] eq 'fnaFile') { $seq_col = $i; last; }
        }
        if ($seq_col >= 0) {
            for my $s (sort keys %samples) {
                my $entry = $map_href->{$s}->[$seq_col] // "";
                if ($entry eq "") { push @problems, "Mapping SampleID '$s' has an empty sequence-file entry in fastqFile/fnaFile column"; next; }
                for my $mf (split(/,/, $entry)) {
                    next if $mf eq "";
                    my $path = $mf;
                    $path = File::Spec->catfile($inputArray[0], $mf) if @inputArray == 1 && -d $inputArray[0] && !-f $path;
                    my @issues = _minimum_input_file_issues($path);
                    push @problems, "Mapping SampleID '$s' sequence file '$mf' $_" for @issues;
                }
                if (scalar(grep { $_ ne "" } split(/,/, $entry)) > 2) {
                    push @problems, "Mapping SampleID '$s' lists more than two sequence files";
                }
            }
        } elsif (@files) {
            my $matched = 0;
            for my $f (@files) {
                my $b = basename($f); $b =~ s/\.gz$//i; $b =~ s/\.(?:fastq|fq|fna|fa|fasta)(?:\.[A-Za-z0-9_-]+)*$//i; $b =~ s/(?:_R?[12]|\.[12])$//i;
                $matched++ if exists $samples{$b};
            }
            if ($matched == 0 && scalar(keys %samples) > 0 && @files <= 20) {
                push @warnings, "No input file basenames matched mapping SampleIDs in the approximate validation scan. This may be valid for demultiplexed/barcoded runs, but should be checked.";
            }
        }
    }

    if (@warnings) {
        printL("Input validation warnings:\n" . join("\n", map { " - $_" } @warnings) . "\n", "w");
    }
    if (@problems) {
        my $msg = "Input validation failed before execution:\n" . join("\n", map { " - $_" } @problems) . "\n";
        if ($strictMode) { printL($msg, 71); } else { printL($msg, "w"); }
    }
}

sub validate_refdb_tax_overlap {
    my ($db, $tax, $max_ids) = @_;
    $max_ids ||= 5000;
    return (undef, "") unless defined $db && defined $tax && -s $db && -s $tax;
    my (%dbids, %taxids); my ($ndb, $ntax) = (0,0);
    my $dfh = _open_maybe_gzip($db) or return (undef, "Cannot open reference FASTA $db");
    while (my $l = <$dfh>) { if ($l =~ /^>(\S+)/) { $dbids{$1}=1; last if ++$ndb >= $max_ids; } }
    close $dfh;
    my $tfh = _open_maybe_gzip($tax) or return (undef, "Cannot open taxonomy file $tax");
    while (my $l = <$tfh>) {
        next if $l =~ /^\s*$/;
        my ($id) = split(/\t|\s+/, $l);
        next unless defined $id && $id ne "";
        $ntax++;
        $taxids{$id}=1 if exists $dbids{$id};
        last if keys(%taxids) == $ndb;
    }
    close $tfh;
    return (undef, "Reference/taxonomy overlap check had no IDs to compare for $db and $tax") if !$ndb || !$ntax;
    my $overlap = scalar(keys %taxids);
    return ($overlap / $ndb, "");
}

