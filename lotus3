		systemL("cp $sdmOpt $outdir/primary");
		if ( systemL($sdmcmd) != 0 ) {
			printL "FAILED sdm demultiplexing step: " . $sdmcmd . "\n";
			exit(4);
		}
		my $fileNum = `ls -1 $mainSDMlog* | wc -l`;
		my @sdmOfiles = glob("${mainSDMlog}0*");

		if ( $fileNum > 0 && @sdmOfiles>0) {
			systemL "mkdir -p $logDir/SDMperFile/; mv $mainSDMlog". "0* $logDir/SDMperFile/";
		}
		if ( $fileNum > 10 ) {
			systemL "tar zcf $logDir/SDMperFile.tar.gz $logDir/SDMperFile/; rm -r $logDir/SDMperFile/;";
		}
		open my $sdm_log_fh, "<", $mainSDMlog
			or printL("Could not read the SDM summary log $mainSDMlog: $!\n", 4);
		my $readSdmLog = do { local $/; <$sdm_log_fh> };
		close $sdm_log_fh or printL("Could not close the SDM summary log $mainSDMlog: $!\n", 4);
		my $readSdmDereLog = "";
		if (-f $mainSDMdereplog) {
			open my $sdm_derep_fh, "<", $mainSDMdereplog
				or printL("Could not read the SDM dereplication log $mainSDMdereplog: $!\n", 4);
			$readSdmDereLog = do { local $/; <$sdm_derep_fh> };
			close $sdm_derep_fh
				or printL("Could not close the SDM dereplication log $mainSDMdereplog: $!\n", 4);
		}
		if ( $readSdmLog =~ m/binomial (?:est\.|estimated) errors/i ) {
			$citations .= "Poisson binomial model based read filtering: Fernando Puente-Sánchez, Jacobo Aguirre, Víctor Parro (2015).A novel conceptual approach to read-filtering in high-throughput amplicon sequencing studies. Nucleic Acids Res.(2015).\n";
		}
		
