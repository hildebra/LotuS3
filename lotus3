sub readTaxIn($ $ $ $ ) {
    my ( $inT, $LCAtax, $biomFmt, $calcHit2DB ) = @_;
    my %Taxo;    #
    my @lvls =
      ( "Domain", "Phylum", "Class", "Order", "Family", "Genus", "Species" );
    my @lvls2 = ( "k__", "p__", "c__", "o__", "f__", "g__", "s__" );
    my %hit2DB;
    my %hit2DBtax;
    my $taxStart   = 0;    #RDP case
    my $taxEnd     = 7;
    my $tarEntr    = 7;
    my $hit2DBEntr = 8;

    if ( $LCAtax == 1 ) {    #LCA case
        $taxStart = 1;
        $taxEnd   = 8;
        $tarEntr  = 0;
        unshift @lvls,  "OTU";
        unshift @lvls2, "";
    }
    open I, "<", $inT or die("$inT not found: $!\n");
    my $markLvl = -1;
    my $cnt     = -1;
    while ( my $line = <I> ) {
        chomp($line);
        $cnt++;
        my @spl = split( /\t/, $line );
        if ( $cnt == 1 && $markLvl == -1 ) {
            $markLvl = 0;
            $markLvl = 1 unless ( $spl[0] =~ m/[kpc]__/ );
        }
        for ( my $i = 0 ; $i < @spl ; $i++ ) {
            $spl[$i] = "?" if ( $spl[$i] eq "" );
        }
        next
          if ( $cnt == 0 )
          ; #|| $spl[0] eq "domain" || $spl[0] eq "Domain" || $spl[0] eq "OTU");
            #phylum unknown: ignore entry
            #if ($spl[1] eq "?" && $spl[2] eq "?"){next;}
        if ( @spl < 6 ) { die $line; }
        if ( $markLvl == 1 && $biomFmt == 1 ) {    #add k__ etc tags
            for ( my $i = 0 ; $i < @lvls2 ; $i++ ) {
                chomp $spl[$i];
                $spl[$i] = $lvls2[$i] . $spl[$i];
            }
        }
        if ( $biomFmt == 1 ) {                     #simple joining of levels
                #print ("@spl $taxStart .. $taxEnd\n");
            $Taxo{ $spl[$tarEntr] } =
              join( "\", \"", @spl[ $taxStart .. ( $taxEnd - 1 ) ] );
        }
        else {    #complex add up of levels
            my $foreRun = $spl[$taxStart];
            for ( my $i = $taxStart + 1 ; $i < $taxEnd ; $i++ ) {
                my $tartax = $foreRun . ";" . $spl[$i];
                if ( exists( $Taxo{ $lvls[$i] }{$tartax} ) ) {
                    push( @{ $Taxo{ $lvls[$i] }{$tartax} }, $spl[$tarEntr] );
                }
                else {
                    my @tmp = ( $spl[$tarEntr] );
                    $Taxo{ $lvls[$i] }{$tartax} = \@tmp;
                }
                $foreRun = $tartax;
            }
        }

        #prepare tag for greengenes hit
        if ($calcHit2DB) {
            if ( $spl[$hit2DBEntr] ne "?" ) {

                #previous one link.. no longer needed
                #$hit2DB{$spl[$tarEntr]} = $spl[$hit2DBEntr];}
                if ( exists( $hit2DB{ $spl[$hit2DBEntr] } ) ) {
                    push( @{ $hit2DB{ $spl[$hit2DBEntr] } }, $spl[$tarEntr] );
                }
                else {
                    my @tmp = ( $spl[$tarEntr] );
                    $hit2DB{ $spl[$hit2DBEntr] } = \@tmp;
                }

                #for bioim format, need to change the lvls
                if ( $markLvl == 1 ) {
                    for ( my $i = 0 ; $i < @lvls2 ; $i++ ) {
                        chomp $spl[$i];
                        $spl[$i] = $lvls2[$i] . $spl[$i];
                    }
                }
                $hit2DBtax{ $spl[$hit2DBEntr] } =
                  join( "\", \"", @spl[ $taxStart .. ( $taxEnd - 1 ) ] )
                  ;    #in biom format

            }
            else { $hit2DB{ $spl[$tarEntr] } = [ $spl[$tarEntr] ]; }
        }
    }
    close I;

    #create high  lvl matrix
    if ( $LCAtax == 1 ) {    #LCA case
        shift @lvls;
        shift @lvls2;
    }
    return ( \%Taxo, \@lvls, \%hit2DB, \%hit2DBtax );
}

sub biomFmt($ $ $ $ $) {
    my ( $otutab, $inT, $bioOut, $LCAtax, $bioTaxXHR ) = @_;
    my %bioTaxX = %{$bioTaxXHR};
    my %mapH    = %{$mapHref};
    my %combH   = %{$combHref};
    if ($hasCombiSmpls) {
        printL "Combined samples in lotus run.. attempting merge of metadata in .biom file\n","w";
    }
    my %OTUmat  = %{$otutab};
    my @avSmps  = sort grep { $_ ne "OTU" } keys %OTUmat;
    printL "Cannot create BIOM: abundance table has no samples\n", 72 unless @avSmps;
    my @avOTUs  = sort keys %{ $OTUmat{ $avSmps[0] } // {} };
    printL "Cannot create BIOM: abundance table has no OTUs\n", 72 unless @avOTUs;
    my @colNms = exists($mapH{'#SampleID'}) ? @{ $mapH{'#SampleID'} } : ();

    my ( $hr1, $ar1, $hr2, $hr3 ) = readTaxIn( $inT, $LCAtax, 1, 0 );
    my %Tax    = %{$hr1};

    my @rows;
    for my $id (@avOTUs) {
        my $taxstr = exists($Tax{$id}) ? $Tax{$id}
                   : exists($bioTaxX{$id}) ? $bioTaxX{$id}
                   : 'k__?", "p__?", "c__?", "o__?", "f__?", "g__?", "s__?';
        my @taxonomy = split(/\s*\",\s*\"\s*/, $taxstr // "");
        push @rows, { id => "$id", metadata => { taxonomy => \@taxonomy } };
    }

    my @columns;
    for my $smpl (@avSmps) {
        my $metadata;
        if (exists($combH{$smpl}) && exists($mapH{$combH{$smpl}})) {
            my @curMeta = @{ $mapH{$combH{$smpl}} };
            my %meta;
            for (my $i = 0; $i < @colNms; $i++) {
                $meta{$colNms[$i]} = defined($curMeta[$i]) ? "$curMeta[$i]" : "";
            }
            $metadata = \%meta;
        } else {
            printL "Potential problem with .biom table: Could not find sample \"$smpl\" in metadata; writing null metadata.\n", "w";
            $metadata = undef;
        }
        push @columns, { id => "$smpl", metadata => $metadata };
    }

    my @data;
    for my $otu (@avOTUs) {
        my @row;
        for my $smpl (@avSmps) {
            my $value = exists($OTUmat{$smpl}{$otu}) ? $OTUmat{$smpl}{$otu} : 0;
            printL "Cannot create BIOM: non-integer or negative count '$value' for $otu/$smpl\n", 72
                unless defined($value) && $value =~ /^\d+$/;
            push @row, 0 + $value;
        }
        push @data, \@row;
    }

    my $biom = {
        id => undef,
        format => "Biological Observation Matrix 1.0.0",
        format_url => "http://biom-format.org/documentation/format_versions/biom-1.0.html",
        type => "OTU table",
        generated_by => $selfID,
        LotuS_output_schema_version => $LotuS_output_schema_version,
        date => strftime("%Y-%m-%dT%H:%M:%SZ", gmtime),
        rows => \@rows,
        columns => \@columns,
        matrix_type => "dense",
        matrix_element_type => "int",
        shape => [scalar(@avOTUs), scalar(@avSmps)],
        data => \@data,
    };
    my $biomo = JSON::PP->new->canonical(1)->pretty(1)->encode($biom);
    atomic_write_text($bioOut, $biomo);
}

sub truePath($){
	my ($tmp) = @_;
	return "" unless defined($tmp) && $tmp ne "";
	my $relative = File::Spec->catfile($RealBin, $tmp);
	return abs_path($relative) // $relative if -f $relative;
	return abs_path($tmp) // $tmp if -f $tmp;
	return command_exists($tmp) // "";
}

sub configDataPath($) {
    my ($value) = @_;
    return "" unless defined($value) && $value ne "";
    return $value if File::Spec->file_name_is_absolute($value);
    my $local = File::Spec->catfile($RealBin, $value);
    return abs_path($local) // $local if -e $local;
    return $local;
}

