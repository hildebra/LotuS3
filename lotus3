sub delineateUCs($ $) {
    my ( $ifi, $mode ) = @_;
    open UC, "<", $ifi or die "Could not read UC file $ifi: $!\n";
    my %clus;
    my %expSize = ();
    while ( my $line = <UC> ) {
        chomp($line);
        next if $line =~ /^\s*$/;
        my @spl     = split( "\t", $line, -1 );
        next unless $spl[0] =~ /^(?:S|H|C)$/;
        die "Malformed UC record in $ifi: $line\n" unless @spl > 8;
        die "Malformed UC hit record in $ifi: $line\n" if $spl[0] eq "H" && @spl <= 9;
        my $hit     = $spl[9] // "*";
        my $que     = $spl[8];
        my $hitsize = 1;
        my $quesize = 1;
        if ( $mode >= 1 ) {

            # if $mode==1;
            if ( $mode == 1 ) {
                my ($parsed_query_size) = $que =~ /;size=(\d+)/;
                die "Missing query size annotation in UC record: $line\n" unless defined $parsed_query_size;
                $quesize = $parsed_query_size;
                $que =~ s/;size=\d+.*$//;
            }
            if (defined($hit) && $hit ne "*") {
                my ($parsed_hit_size) = $hit =~ /;size=(\d+)/;
                die "Missing hit size annotation in UC record: $line\n" if $spl[0] eq "H" && !defined $parsed_hit_size;
                if (defined $parsed_hit_size) {
                    $hitsize = $parsed_hit_size;
                    $hit =~ s/;size=\d+.*$//;
                }
            }
        }
        if ( $mode == 3 )
        { #switch hit and que, because in UPARSE case, reads are aligned to OTUs (= not backtracing)
                #print($quesize." ".$hitsize."\n");
            my $temp = $hit;
            $hit     = $que;
            $que     = $temp;
            $temp    = $hitsize;
            $hitsize = $quesize;
            $quesize = $temp;
        }

        if ( $spl[0] eq "H" ) {    #in cluster
            if ( exists( $clus{$hit} ) ) {
                push( @{ $clus{$hit} }, $que );
                $expSize{$hit} += $quesize;
            }
            else {
                my @empty = ( $hit, $que );
                $clus{$hit}    = \@empty;
                $expSize{$hit} = $quesize + $hitsize;
            }
        }
        if ( $spl[0] eq "S" ) {    #starts new cluster

            #	print $hit." ".$que."\n"; die();
            if ( !exists( $clus{$que} ) ) {
                my @empty = ($que);
                $clus{$que}    = \@empty;
                $expSize{$que} = $quesize;
            }
        }
        if ( $mode != 2 ) {
            if ( $spl[0] eq "C" )
            { #all "H" should have appeared at this point; cross-check if cluster size is right

                if ( !exists( $clus{$que} ) ) {
                    die("Entry for $que does not exist (but should exist).\n");
                }
                else {
                    my $arraySize = scalar( @{ $clus{$que} } );
                    if ( $spl[2] != $expSize{$que} ) {
                        printL(
                            "$que :: expected "
                              . $spl[2]
                              . " cluster size. found cluster size: "
                              . $expSize{$que}
                              . " from array with S $arraySize.\n",
                            0
                        );
                        foreach ( @{ $clus{$que} } ) {
                            printL $_. "\n", 0;
                        }
                        die();
                    }
                }
            }
        }
    }
    close UC;
    return \%clus;
}

