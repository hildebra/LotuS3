sub getOTUsize($){
	my ($otuM) = @_;
	my %ret;
	open I,"<$otuM" or die "can't open matrix $otuM\n";
	my $cnt=0;
	while(<I>){
		chomp;
		$cnt++; next if ($cnt == 1);
		my @spl = split /\t/;
		my $key = shift @spl;
		my $oc=0;
		foreach my $occ (@spl){$oc += $occ;}
		$ret{$key} = $oc;
	}
	close I;
	return \%ret;
}


sub replaceFastaHd($ $) {
	my ( $href, $ifil ) = @_;
	my $ofil = $ifil . ".tmp";
	my %fa   = %{$href};
	open O, ">", $ofil;
	open( FAS, "<", "$ifil" ) || die("Couldn't open FASTA file.");
	my %Hseq;
	my $line;
	while ( $line = <FAS> ) {
		if ( $line =~ m/^>/ ) {
			chomp($line);
			$line =~ s/;size=\d+;//;
			$line = substr( $line, 1 );
			if ( !exists( $fa{$line} ) ) { die("can't find key $line\n"); }
			$line = ">" . $line . ";size=" . $fa{$line} . ";\n";
		}
		print O $line;
	}
	close FAS;
	close O;
	rename( $ofil, $ifil ) or die "Unable to overwrite file $ifil\n";
}



