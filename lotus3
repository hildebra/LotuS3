sub readOTUmat($) {
    my ($file) = @_;
    open my $fh, "<", $file or die "Can't open expected ${OTU_prefix} counts: $file\n";
    my $line_no = 0;
    my @samples;
    my @avOTUs;
    my %OTUm;
    my %seen_otu;
    while ( my $line = <$fh> ) {
        $line_no++;
        $line =~ s/[\r\n]+$//;
        die "Blank line in ${OTU_prefix} count table $file at line $line_no\n" if $line eq "";
        my @spl = split( /\t/, $line, -1 );
        if ( $line_no == 1 ) {
            die "${OTU_prefix} count table $file must have an OTU column and at least one sample column\n" unless @spl >= 2;
            my $first = shift @spl;
            die "Unexpected first header '$first' in ${OTU_prefix} count table $file (expected OTU)\n" unless $first eq "OTU";
            @samples = @spl;
            my %seen_sample;
            for my $sample (@samples) {
                die "Empty sample ID in ${OTU_prefix} count table $file\n" if $sample eq "";
                die "Duplicate sample ID '$sample' in ${OTU_prefix} count table $file\n" if $seen_sample{$sample}++;
            }
            next;
        }
        my $curOT = shift(@spl);
        die "Empty OTU ID in $file at line $line_no\n" if !defined($curOT) || $curOT eq "";
        die "Duplicate OTU ID '$curOT' in $file at line $line_no\n" if $seen_otu{$curOT}++;
        die "Wrong number of columns in $file at line $line_no (expected " . (scalar(@samples) + 1) . ", found " . (scalar(@spl) + 1) . ")\n"
            unless @spl == @samples;
        for my $value (@spl) {
            die "Invalid abundance '$value' for $curOT in $file at line $line_no; counts must be non-negative integers\n"
                unless defined($value) && $value =~ /^\d+$/;
        }
        push( @avOTUs, $curOT );
        for ( my $i = 0 ; $i < @samples ; $i++ ) {
            $OTUm{ $samples[$i] }{$curOT} = 0 + $spl[$i];
        }
    }
    close $fh or die "Error reading ${OTU_prefix} count table $file: $!\n";
    die "Empty ${OTU_prefix} count table: $file\n" unless $line_no;
    die "${OTU_prefix} count table contains no data rows: $file\n" unless @avOTUs;
    return ( \%OTUm, \@avOTUs );
}

sub utaxTaxAssign($ $) {
    my ( $query, $taxblastf ) = @_;
    if ( !-f $usBin ) { printL "usearch binary not found: $usBin\n", 81; }
    my $dbfa = $TAX_REFDB[0];
    if ( !-d $dbfa ) { printL "wrong utax database dir: $dbfa\n", 82; }

    #contains path to utax dir
    my $taxLconf = "120";    #250,500,full_length
    if ( $platform eq "454" )    { $taxLconf = 500; }    #454, miSeq, hiSeq
    if ( $platform eq "miseq" ||$platform eq  "aviti" )  { $taxLconf = 250; }
    if ( $platform eq "pacbio" || $platform eq "pacbio_ga") { $taxLconf = 700; }
    my $utFas  = "$dbfa/fasta/refdb.fa";
    my $utUdb  = "$dbfa/fasta/refdb.$taxLconf.udb";
    my $utConf = "$dbfa/taxconfs/$taxLconf.tc";

    $cmd = "";
    unless ( -e $utUdb ) {
		if ($usearchVer < 9){
			$cmd .= "$usBin -makeudb_utax $utFas -output $utUdb -taxconfsin $utConf;";
		} else {
			$cmd .= "$usBin -makeudb_usearch $utFas -output $utUdb ;";
		}
		 
    }
	my $taxnm = "SINTAX";
	if ($usearchVer < 9){
		$cmd .= "$usBin -utax $query -db $utUdb -utaxout $taxblastf -strand both;";
		$taxnm = "UTAX";
	} else {
		$cmd .= "$usBin -sintax $query -db $utUdb -tabbedout $taxblastf -threads $BlastCores -strand both;";
	}

    #die $utaCmd."\n";

    if ( $exec == 0 ) {
        printL frame("Assigning taxonomy using $taxnm with confidence $taxLconf bp");

        #print $cmd."\n";
        if ( systemL($cmd) ) { printL "$taxnm failed:\n$cmd\n", 3; }
    }
    return $taxblastf;
}

