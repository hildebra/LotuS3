sub splitBlastTax($ $) {
    my ( $blf, $num ) = @_;
    my $blLines = `wc -l $blf | cut -f1 -d ' ' `;
    my $endL    = int( $blLines / $num );
    if ( $endL < 3000 ) { $endL = 3000; }
    my $subLcnt = $endL;
    my @subf;
    my $fcnt   = 0;
    my $totCnt = 0;
    open I, "<$blf" or die "Can't open to split $blf\n";
    my $lstHit = "";
    my $OO;

    while ( my $l = <I> ) {
        next if $l =~ /^\s*$/;
        my ($hit) = $l =~ m/^(\S+)\s/
          or die "Malformed BLAST output line in $blf: $l";

        if ( $hit ne $lstHit && $subLcnt >= $endL ) {

            #open new file
            #print "$lstHit  $hit $subLcnt\n";
            $subLcnt = 0;
            $lstHit  = $hit;
            close $OO if ( defined $OO );
            open $OO, ">", "$blf.$fcnt"
              or die "Could not write split BLAST output $blf.$fcnt: $!\n";
            push( @subf, "$blf.$fcnt" );
            $fcnt++;
        }
        else {
            $lstHit = $hit;    #has to continue until next time a change occurs..
        }
        print $OO $l;
        $subLcnt++;
        $totCnt++;

    }
    close $OO;
    close I;

    #die $blLines." $blf\n";
    #die "@subf\n$totCnt\n";
    return @subf;
}

sub getTaxForOTUfromRefBlast($ $ $) {
    my ( $blastout, $GGref, $interLMode ) = @_;

    #sp,ge,fa,or,cl,ph
    my %GG       = %{$GGref};
    my @ggk      = keys(%GG);
    my $maxGGdep = scalar( @{ $GG{ $ggk[0] } } );
    @ggk = ();
    open B, "<", $blastout or die "Could not read $blastout\n";
    my $sotu    = "";
    my $sID     = 0;
    my $sLength = 0;

    #my @sTax=(); my @sMaxTaxNum = ();
    my $retRef   = {};    # my $retDRef ={};
    my $cnt      = 0;
    my @tmpLines = ();    #stores Blast lines
    my @spl;              #temp line delim
    my %prevQueries = ();
    my $line2       = "";
    while ( my $line = <B> ) {
        $cnt++;
        chomp $line;
        $line2 = $line;
        my @spl  = split( "\t", $line );
        my $totu = $spl[0];                #line otu
        $totu =~ s/^>//;
        if ( $cnt == 1 ) { $sotu = $totu; }

        #print $line." XX $spl[11] $spl[10]\n"; die () if ($cnt > 50);

#check if this is a 2 read-hit type of match (interleaved mode) & merge subsequently
        if ($interLMode) {
            if ( @tmpLines > 0 && exists( $prevQueries{ $spl[1] } ) ) {
                my @prevHit = @{ $prevQueries{ $spl[1] } };
                die
"something went wrong with the inter matching: $prevHit[1] - $spl[1]\n"
                  unless ( $prevHit[1] eq $spl[1] );
                $prevHit[11] += $spl[11];    #bit score
                $prevHit[3]  += $spl[3];
                $prevHit[5]  += $spl[5];
                $prevHit[4] +=
                  $spl[4];    #alignment length,mistmatches,gap openings
                $prevHit[2] = ( $prevHit[2] + $spl[2] ) / 2;

                #$tmpLines[-1] = \@prevHit;
                @spl = @prevHit;

                #next;
            }
            else { $prevQueries{ $spl[1] } = \@spl; }
        }
        if ( ( $spl[11] < $minBit ) || ( $spl[10] > $minEval ) )
        {                     #just filter out..
            $spl[2] = 0;      #simply deactivate this way...
        }

        if ( $sotu eq $totu ) {
            push( @tmpLines, \@spl );
            if ( $spl[2] > $sID && $spl[3] > $sLength ) {
                $sID     = $spl[2];
                $sLength = $spl[3];
            }
            if ( $spl[3] > ( $sLength * 1.4 ) && $spl[2] > ( $sID * 0.9 ) ) {
                $sID     = $spl[2];
                $sLength = $spl[3];
            }                 #longer alignment is worth it..
                              #print $sID."\n";
        }
        else {
            #print "Maybe\n";
            ($retRef) =
              rework_tmpLines( \@tmpLines, $retRef, $sotu, \@spl, $sID,
                $sLength, \%GG, $maxGGdep )
              if ( $sotu ne "" );
            $sotu = $totu;
            undef @tmpLines;
            undef %prevQueries;
            push( @tmpLines, \@spl );
            $prevQueries{ $spl[1] } = \@spl;
            $sID                    = $spl[2];
            $sLength                = $spl[3];
        }
    }

    #last OTU in extra request
    if ( $sotu ne "" ) {
        my @spl = split( "\t", $line2 );
        ($retRef) =
          rework_tmpLines( \@tmpLines, $retRef, $sotu, \@spl, $sID, $sLength,
            \%GG, $maxGGdep );
    }
    close B;

    #debug
    #my %ret = %{$retRef};	my @tmp = @{$ret{$sotu}};print "\n@tmp  $sotu\n";

    return ($retRef);
}

sub numberOTUs($ $ $) {    #rewrites OTUs with new header (numbered header)
    my ( $inf, $outf, $pref ) = @_;
    open X,  "<", $inf or die "Could not read FASTA $inf: $!\n";
    open XX, ">", $outf or die "Could not write FASTA $outf: $!\n";
    open L,  ">", $inf . "_convertNames" or die "Could not write name conversion file for $inf: $!\n";
    my $wrLine = "";
    my $cnt    = 0;
    my %lnk;
    while ( my $line = <X> ) {
        if ( $line =~ m/^>/ ) {
            print XX ">" . $pref . $cnt . "\n";
            my ($tmp) = $line =~ m/^>(\S+)/;
            die "Empty FASTA identifier in $inf\n" unless defined $tmp;
            $tmp =~ s/;size.*//;
            die "Empty normalized FASTA identifier in $inf\n" if $tmp eq "";
            $lnk{$tmp} = $pref . $cnt;

            print L $tmp . "\t" . $pref . $cnt . "\n";
            $cnt++;
        }
        else {
            print XX $line;
        }
    }
    close X;
    close XX;
    close L;

    return \%lnk;
}


sub readFastaHd($) {
    my ($fil) = @_;
    open( FAS, "<", "$fil" ) || die("Couldn't open FASTA file $fil.");
    my %Hseq;
    my $line;
    while ( $line = <FAS> ) {
        if ( $line =~ m/^>/ ) {
            chomp($line);
            $line =~ s/;size=\d+;.*//;
            $line = substr( $line, 1 );

            #die $line."\n";
            $Hseq{$line} = 0;
        }
    }
    close FAS;
    return \%Hseq;
}


sub newUCSizes($ $) {
    my ( $fafil, $ucfil ) = @_;
    my $hr = readFastaHd($fafil);
    my %fa = %{$hr};

    #read UC file
    open UC, "<", $ucfil or die "Could not read UC file $ucfil: $!\n";
    my $tok;
    my @splu;
    while ( my $line = <UC> ) {
        chomp($line);
        my $cnt;
        if ( $line =~ m/^S/ ) {
            @splu = split( /\t/, $line );
            die "Malformed seed record in UC file $ucfil: $line\n" unless @splu > 8;
            $tok  = $splu[8];
            ($cnt) = $tok =~ m/;size=(\d+);/;
            die "Missing size annotation in UC seed record: $line\n" unless defined $cnt;
            $tok =~ s/;size=\d+;//;
        }
        elsif ( $line =~ m/^H/ ) {
            @splu = split( /\t/, $line );
            die "Malformed hit record in UC file $ucfil: $line\n" unless @splu > 9;
            $tok  = $splu[9];
            $tok =~ s/;size=\d+;//;
            my $tik = $splu[8];
            ($cnt) = $tik =~ m/;size=(\d+);/;
            die "Missing size annotation in UC hit record: $line\n" unless defined $cnt;
        } else {
            next;
        }
        if ( !exists( $fa{$tok} ) ) {
            die("Expected fasta seq with head $tok\n");
        }
        $fa{$tok} += $cnt;
    }
    close UC;

    replaceFastaHd( \%fa, $fafil );
}

sub reverse_complement_IUPAC {
    my $dna = shift;

    # reverse the DNA sequence
    my $revcomp = reverse($dna);

    # complement the reversed DNA sequence
    $revcomp =~
      tr/ABCDGHMNRSTUVWXYabcdghmnrstuvwxy/TVGHCDKNYSAABWXRtvghcdknysaabwxr/;
    return $revcomp;
}

sub revComplFasta {
    my ($inF) = @_;
    open I, "<$inF";
    open O, ">$inF.tmp";
    while ( my $l = <I> ) {
        chomp $l;
        if ( $l !~ m/^>/ ) { $l = reverse_complement_IUPAC($l); }
        print O $l . "\n";
    }
    close I;
    close O;
    systemL "rm -f $inF; mv $inF.tmp $inF;";
}

sub readFasta($) {
    my ($fil) = @_;
    my %Hseq;
    printL("Couldn't open FASTA file $fil: file does not exist\n", 88) unless defined($fil) && -e $fil;
    return \%Hseq if -z $fil;
    open my $fh, "<", $fil or printL( "Couldn't open FASTA file $fil: $!\n", 88 );
    my ($current, $sequence) = (undef, "");
    while (my $line = <$fh>) {
		$line =~ s/[\r\n]+$//;
		if ($line =~ /^>(\S+)/) {
			if (defined $current) {
				printL "Duplicate FASTA identifier '$current' in $fil\n", 88 if exists $Hseq{$current};
				$Hseq{$current} = $sequence;
			}
			$current = $1;
			$current =~ s/;size=\d+;.*//;
			$sequence = "";
		} elsif ($line =~ /\S/) {
			printL "FASTA sequence encountered before the first header in $fil\n", 88 unless defined $current;
			$sequence .= $line;
		}
    }
    if (defined $current) {
		printL "Duplicate FASTA identifier '$current' in $fil\n", 88 if exists $Hseq{$current};
		$Hseq{$current} = $sequence;
	}
    close($fh) or printL "Error reading FASTA file $fil: $!\n", 88;
    return \%Hseq;
}

