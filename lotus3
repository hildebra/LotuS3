sub getDefAligner(){
	my $defaultTaxAlig = 2; #LAMBDA: No 1 default
	if ( !-f $lambda3Bin ) {
		#if ( -f $lambdaBin ) { $defaultTaxAlig = 2; print "Found older lambda version, using $lambdaBin\n"; }  #lambda.. old version
		if ( -f $VSBin ) { $defaultTaxAlig = 4; } #VSEARCH
		elsif ( -f $usBin ) { $defaultTaxAlig = 5; } #USEARCH 
		elsif ( -f $blastBin ) { $defaultTaxAlig = 1; } #BLAST
		elsif ( !-f $blastBin && $refDBwanted ne "" ) {
			printL ("Requested similarity search ($refDBwanted), but no suitable aligner (blast, vsearch, usearch, lambda) binaries found!\n",50);
		}
	}
	return $defaultTaxAlig;
}

sub prepLtsOptions{
	
	#create dirs
	my $resetOutdir = 0;
	if ($TaxOnly eq "1" || $onlyTaxRedo) {
		my $redo_source = $dryRun && $dryRunRequestedOutdir ne "" ? $dryRunRequestedOutdir : $outdir;
		die "Taxonomy redo requires an existing LotuS output directory: $redo_source\n" unless -d $redo_source;
		die "Taxonomy redo output must not be a symbolic link: $redo_source\n" if -l $redo_source;
		my $redo_fasta = File::Spec->catfile($redo_source, "OTU.fna");
		die "Taxonomy redo requires a non-empty OTU.fna in $redo_source\n" unless -s $redo_fasta;
		# A full OTU FASTA pass is unnecessary here; taxonomy processing will consume it below.
		my ($records, $fasta_problems) = fasta_validation_scan($redo_fasta, 1);
		die "Taxonomy redo OTU.fna validation failed:\n" . join("\n", map { " - $_" } @$fasta_problems) . "\n"
			if @$fasta_problems;
		if ($onlyTaxRedo) {
			my $redo_table = File::Spec->catfile($redo_source, "OTU.txt");
			die "-redoTaxOnly requires a non-empty OTU.txt in $redo_source\n" unless -s $redo_table;
		}
	}
	if ($TaxOnly eq "0" ){
		$resetOutdir = ( $exec == 0 && $onlyTaxRedo == 0 ) ? 1 : 0;
		unlink($progOutPut) if (-e $progOutPut); #from here log systemL
	}
	
	
	#reset logfile
	#create output folders
	if ($TaxOnly ne "0" && -f $TaxOnly && -d $outdir) {
		opendir my $tod, $outdir or die "Cannot inspect taxonomy-only output directory $outdir: $!\n";
		my @existing = grep { $_ ne "." && $_ ne ".." } readdir($tod);
		closedir $tod;
		die "Taxonomy-only output directory already contains files; refusing to overwrite it: $outdir\n" if @existing;
	}
	validate_output_directory_compatibility($outdir, $resetOutdir);
	ensure_dir($outdir) unless ( -d $outdir );
	acquire_output_lock($outdir) unless $dryRun;
	if ($resetOutdir) {
		safe_remove_tree($outdir, "output directory");
		ensure_dir($outdir);
	}
	if ($TaxOnly eq "0" && $exec == 0 && $onlyTaxRedo == 0) {
		atomic_write_text($outdirCreatedMarker, "LotuS3 temporary ownership marker for this run\n");
	}
	ensure_dir("$outdir/primary/") unless ( -d "$outdir/primary" );
	ensure_dir($logDir) unless ( -d $logDir );
	ensure_dir($extendedLogD) if ($extendedLogs && !-d $extendedLogD);	
	if ($TaxOnly eq "1" && !$dryRun) {
		my $k = 0;
		$taxRedoArchiveDir = "$outdir/prevLtsTax_$k";
		while (-e $taxRedoArchiveDir) {
			$k++;
			$taxRedoArchiveDir = "$outdir/prevLtsTax_$k";
		}
		my $archive_logs = File::Spec->catdir($taxRedoArchiveDir, "LotuSLogS");
		ensure_dir($archive_logs);
		for my $old_path (
			$highLvlDir, $FunctOutDir, $RDP_hierFile, $SIM_hierFile,
			"$outdir/hierachy_cnt.tax", "$extendedLogD/cnadjusted_hierachy_cnt.tax"
		) {
			next unless defined($old_path) && (-e $old_path || -l $old_path);
			(my $clean_path = $old_path) =~ s{[\\/]+$}{};
			my $destination = File::Spec->catfile($taxRedoArchiveDir, basename($clean_path));
			move($old_path, $destination)
				or die "Could not archive previous taxonomy output $old_path to $destination: $!\n";
		}
		opendir my $old_logs, $logDir or die "Could not inspect previous LotuS logs in $logDir: $!\n";
		my @old_log_entries = grep { $_ ne "." && $_ ne ".." } readdir($old_logs);
		closedir $old_logs;
		for my $entry (@old_log_entries) {
			my $source = File::Spec->catfile($logDir, $entry);
			my $destination = File::Spec->catfile($archive_logs, $entry);
			move($source, $destination)
				or die "Could not archive previous LotuS log $source to $destination: $!\n";
		}
	}
	open LOG, ">", $mainLogFile or die "Can't open Logfile $mainLogFile\n";
	open cmdLOG , ">", $cmdLogFile or die "Can't open cmd log $cmdLogFile\n";
	
	
	#check and format input:
	@inputArray = split( /,/, $input );
	@inqArray   = split( /,/, $inq );
	$numInput = scalar(@inputArray);
	if ( scalar(@inqArray) > 0  && $numInput != scalar(@inqArray)  && -f $inqArray[0] ){
		printL("Error: fasta input file number does not correspond ot quality file number.\n", 1);
	}

	

	#auto set num threads to max currently available on this system/allocation.
	if ($uthreads == -1){
		$uthreads = detect_available_cpus();
	}
	#check if pigz exists..
	$gzipC = "pigz -p $uthreads " if (command_exists("pigz"));
	#die "$gzipC\n";

	#tmp dir config
	$lotus_tempDir = $outdir . "/tmpFiles/" if (!defined($lotus_tempDir) || $lotus_tempDir eq "");
	$BlastCores = $uthreads;
	if ($sdmThreads == -1){		$sdmThreads = $uthreads ;	}

	if ($chimCnt){		$chimCnt = "T";	} else {		$chimCnt = "F";	}

	#still undocumented options: VsearchChimera removePhiX

	#uc/lc some vars
	$platform = lc($platform);
	$ampliconType    = uc($ampliconType);
	$organism        = lc($organism);
	$ClusterPipe_pre = uc($ClusterPipe_pre);
	
		#which program to use for mapping?
	$internalMapper = "V/USEARCH";
	$internalMapper = "minimap2" if ($useMini4map);


	if ($greengAnno) {
		$pseudoRefOTU   = 1;
		$refDBwanted    = "GG2";
		$doBlasting_pre = "2";
		print "Greengenes ID as species ID requested (for integration with software that requires greengenes ID).\nUsing Lambda OTU similarity search and greengenes ref DB\n";
	}    #
	#die "$refDBwanted\n";
	foreach my $refW (split /,/,$refDBwanted){
		#print $refW."\n";
		if ( -f $refW ) {
			#die "$refDBwanted\n";
		}elsif ( $refW =~ m/^GG|GG2|KSGP|KSPG|SLV|UNITE|HITDB|PR2|BEETAX$/i ) {
			#$refDBwanted = uc($refDBwanted);
		}elsif ( $refW ne "" ) {
			print "$refDBwanted not recognized. Aborting..\n";
			exit(5);
		}
	}
	#die;
	if ( $platform eq "hiseq" ) {
		#$linesPerFile = 8000000;
		$sdmOpt = $sdmHiseqOpt if ($ClusterPipe_pre eq "CD-HIT"|| $ClusterPipe_pre eq "CDHIT" || $ClusterPipe_pre eq "3");
	} elsif ( $platform eq "454" ) {
		if ($sdmOpt eq ""){
			$sdmOpt = $sdm454Opt ;
			$sdmOpt = $sdm454CDHITOpt if ($ClusterPipe_pre eq "CD-HIT" || $ClusterPipe_pre eq "CDHIT" || $ClusterPipe_pre eq "3");
		}
	} elsif ( $platform eq "pacbio" || $platform eq "pacbio_ga") {
		$dereplicate_minsize_def = 0;
		$mini2RdPreset = "-x map-pb -u b --secondary=no -c ";
		$ClusterPipe_pre = "CDHIT" if ($ClusterPipe_pre eq "?");
		if ($sdmOpt eq ""){
			$sdmOpt = $sdmPacBioOpt ;
			$sdmOpt = $sdmPacBioITSOpt if (substr( $ampliconType, 0, 3 ) eq "ITS" );
		}
	} elsif ($platform eq "aviti"){
		$sdmOpt =$sdmAVITIOpt;
	}
	
	
	if (  $dereplicate_minsize eq "-1" ){
		$dereplicate_minsize = $dereplicate_minsize_def ;
	}
	
	if ( !-e $sdmOpt && $TaxOnly eq "0") {
		if ( $sdmOpt eq "" ) {
			$sdmOpt = $sdmMiseqOpt; 
			#printL "No sdm Option specified, using default miSeq sdm options: $sdmOpt\n", 0;
		} else {
			#printL "Using sdm option: $sdmOpt\n",0;
		}
		if (!-e $sdmOpt){
			printL "Could not find sdm options file (specified via \"-s $sdmOpt\"). Please make sure this is available.\n Aborting run..\n",33;
		}
	}
	
	if ($idThreshs ne "-1"){
		#die ;
		#printL "Using custom LCA %id thresholds: $idThreshs\n";
		my @spl = split /,/,$idThreshs;
		printL "-LCA_idthresh should be 6 comma separated integers, aborting\n",834 unless (@spl == 6 || @spl == 7);
		for (my $i=0;$i<@spl;$i++){
			printL "Error in arg -LCA_idthresh: '$spl[$i]' is not an integer.\n", 22 unless $spl[$i] =~ /^\d+$/;
			if ( $spl[$i] > 100 || $spl[$i] < 0 ) {
				printL "Error in arg -LCA_idthresh: every entry has to be <100 and >0. Found " . $spl[$i] . ".\n", 22;
			}
			$idThr[$i] = int($spl[$i]);
		}
	}

	my $defDBset = 0;
	if ( $refDBwanted eq "" ) {
		$refDBwanted = "KSGP"; #switch to default KSGP..
		$defDBset    = 1;
	}
	


	#read primary paths to binaries
	readPaths_aligners($lotusCfg);
	validate_runtime_path_safety();
	my $defaultTaxAlig = getDefAligner();

	getSimBasedTax();

	if ( $TaxOnly eq "0" && !defined($input) && !defined($outdir) && !defined($mapFile) ) { 
		defined($input) or usage("-i option (input dir/files) is required\n");
		if ( $input =~ m/\*/ ) {
			usage ("\"*\" not supported in input command. Please see documentation on how to set up the mapping file for several input files.");
		}
		defined($outdir) or usage("-o option (output dir) is required\n");
		if ( !defined($mapFile) ) {
			usage("-m missing option (mapping file)\n");
		}
	}
	if ( !defined($sdmOpt) && $TaxOnly eq "0" ) {
		printL("sdm options not set\n","w");
	}
	#----- part 2 ----------
	
	checkProgVersions();
	

	#die "$VSBin\n";
	#which default aligner?
	
	if ( $doBlasting == -1 ) {
		if ($defDBset) {
			$doBlasting = 0;
		}  else {
			#check which aligner is installed
			if ( substr( $ampliconType, 0, 3 ) eq "ITS" ) {
