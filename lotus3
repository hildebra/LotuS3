sub dependency_report {
    my @rows;
    my $rdp_dependency = $mjar ne "" ? $mjar : $rdpjar ne "" ? $rdpjar : ($ENV{RDP_JAR_PATH} // "");
    my @deps = (
        ["Rscript", $Rscript], ["sdm", $sdmBin], ["LCA", $LCABin],
        ["vsearch", $VSBin], ["usearch", $usBin], ["blastn", $blastBin],
        ["lambda3", $lambda3Bin], ["mafft", $mafftBin], ["clustalo", $clustaloBin],
        ["FastTree", $fasttreeBin], ["IQ-TREE", $iqTreeBin], ["swarm", $swarmBin],
        ["cd-hit", $cdhitBin], ["minimap2", $mini2Bin],
        ["ITSx", $itsxBin], ["hmmsearch", $hmmsrchBin], ["VXtractor", $vxtrBin],
        ["java", command_exists("java") // ""], ["RDP", $rdp_dependency]
    );
    for my $d (@deps) {
        my ($name, $path) = @$d;
        next unless defined $path && $path ne "";
        my $status = (-x $path || -f $path) ? "OK" : "MISSING";
        push @rows, sprintf("%-12s %-8s %s", $name, $status, $path);
    }
    my $report = "LotuS3 dependency report\nLotuS_output_schema_version $LotuS_output_schema_version\n" . join("\n", @rows) . "\n";
    printL($report, 0) if $verbosity > 1;
    my $out = $depReportFile ne "" ? $depReportFile : "$logDir/dependency_report.txt";
    atomic_write_text($out, $report) if defined($logDir) && $logDir ne "";
}

