    }

    my $stamp = strftime("%Y%m%d_%H%M%S", localtime);
    my $root = (defined($outdir) && $outdir ne "") ? $outdir : File::Spec->catdir(".", "LotuS3_selftest_$stamp");
    ensure_dir($root) unless -d $root;
    my $report = File::Spec->catfile($root, "self_test_report.txt");
    my @report;

    push @report, "LotuS3 self-test report";
    push @report, "Date: " . strftime("%Y-%m-%d %H:%M:%S %z", localtime);
    push @report, "Version: $selfID";
    push @report, "Script: $script";
    push @report, "Self-test root: $root";
    push @report, "";
    my ($sdm_parser_ok, $sdm_parser_detail) = selftest_sdm_summary_parser();
    push @report, "Internal parser checks:", "  SDM summary parser: " . ($sdm_parser_ok ? "OK" : "FAILED"),
        "  $sdm_parser_detail", "";
    if (!$sdm_parser_ok) {
        atomic_write_text($report, join("\n", @report) . "\n");
        print STDERR "Self-test SDM parser validation failed. Report: $report\n";
        return 1;
    }
    push @report, "Preflight files:";

    my @preflight = (
        ["Example directory", $example_dir, "dir"],
        ["Example map", $map, "file"],
        ["SDM miSeq2 options", $sdm_miseq2, "file"],
        ["LotuS config", $cfg, "file"],
    );
    my @preflight_errors;
    for my $chk (@preflight) {
        my ($label, $path, $type) = @$chk;
        my $ok = $type eq "dir" ? -d $path : -s $path;
        push @report, sprintf("  %-22s %-7s %s", $label, ($ok ? "OK" : "MISSING"), $path);
        push @preflight_errors, "$label missing or empty: $path" unless $ok;
    }
    if (@preflight_errors) {
        push @report, "", "FAILED before execution:", map { "  - $_" } @preflight_errors;
        atomic_write_text($report, join("\n", @report) . "\n");
        print STDERR join("\n", @preflight_errors) . "\nSelf-test report: $report\n";
        return 1;
    }

    my @example_pairs = (
        ["PID-0292-1_S1_L001_R1_001.fastq.sm.gz", "PID-0292-1_S1_L001_R2_001.fastq.sm.gz", "ANG1"],
        ["PID-0292-2_S2_L001_R1_001.fastq.sm.gz", "PID-0292-2_S2_L001_R2_001.fastq.sm.gz", "ANG2"],
    );
    for my $pair (@example_pairs) {
        my ($p,$w) = validate_fastq_pair(
            File::Spec->catfile($example_dir, $pair->[0]),
            File::Spec->catfile($example_dir, $pair->[1]),
            "self-test example $pair->[2]", 1000000
        );
        push @report, map { "Input warning: $_" } @$w;
        if (@$p) {
            push @report, "FAILED example input validation:", map { "  - $_" } @$p;
            atomic_write_text($report, join("\n", @report) . "\n");
            print STDERR "Self-test example input validation failed. Report: $report\n";
            return 1;
        }
    }
    push @report, "  Example FASTQ structure and mate IDs OK";

    my $selftest_threads = detect_available_cpus();
    push @report, "", "Self-test threads: $selftest_threads (max currently available to this process/allocation)";

    my @cases = (
        {
            name => "basic_example",
            desc => "Core Example/ smoke test using bundled VSEARCH clustering and RDP taxonomy",
            out  => File::Spec->catdir($root, "myTestRun"),
            args => ["-i", $example_dir, "-m", $map, "-CL", "vsearch", "-useMini4map", 0,
                     "-lulu", 0, "-buildPhylo", 0, "-removePhiX", 0, "-deactivateChimeraCheck", 1],
            expected_tax => "hiera_RDP.txt",
            required_tools => [qw(sdm vsearch java RDP)],
        },
        {
            name => "miseq_dada2_lambda",
            desc => "DADA2/Lambda Example/ run equivalent to the documented miSeq2/SLV/lambda command",
            out  => File::Spec->catdir($root, "myTestRun2"),
            args => [
                "-i", $example_dir,
                "-m", $map,
                "-s", $sdm_miseq2,
                "-p", "miSeq",
                "-amplicon_type", "SSU",
                "-forwardPrimer", "GTGYCAGCMGCCGCGGTAA",
                "-reversePrimer", "GGACTACNVGGGTWTCTAAT",
                "-CL", "dada2",
                "-refDB", "SLV",
                "-taxAligner", "lambda",
                "-useMini4map", 0,
                "-lulu", 0,
                "-buildPhylo", 0,
                "-removePhiX", 0,
                "-deactivateChimeraCheck", 1,
            ],
            expected_tax => "hiera_BLAST.txt",
            required_tools => [qw(sdm vsearch Rscript dada2R lambda3 LCA)],
        },
    );

    my $failures = 0;
    for my $case (@cases) {
        push @report, "", "==== $case->{name} ====", $case->{desc};
        my $ok = selftest_run_case($script, $case, \@report, $selftest_threads, $cfg);
        $failures++ unless $ok;
    }

    push @report, "", $failures ? "SELF-TEST FAILED: $failures case(s) failed." : "SELF-TEST PASSED: all cases completed and validated.";
    atomic_write_text($report, join("\n", @report) . "\n");
    my $tail_count = @report < 4 ? scalar(@report) : 4;
    print join("\n", @report[@report-$tail_count .. $#report]) . "\n" if $tail_count;
    print "Self-test report: $report\n";
    return $failures ? 1 : 0;
}


sub atomic_write_text {
    my ($path, $text) = @_;
    die "atomic_write_text called without path\n" unless defined $path && $path ne "";
    my $dir = dirname($path);
    ensure_dir($dir) if defined $dir && $dir ne "" && !-d $dir;
    my $tmp = "$path.tmp.$$";
    open my $fh, ">", $tmp or die "Cannot write $tmp: $!\n";
    print {$fh} ($text // "") or die "Cannot write $tmp: $!\n";
    close $fh or die "Cannot close $tmp: $!\n";
    rename $tmp, $path or die "Cannot replace $path with $tmp: $!\n";
}

sub acquire_output_lock {
    my ($target_outdir) = @_;
    return if defined $outputLockFH;
    my $parent = dirname($target_outdir);
    $parent = "." if !defined($parent) || $parent eq "";
    ensure_dir($parent) unless -d $parent;
    my $base = basename($target_outdir);
    $base =~ s/[^A-Za-z0-9_.-]/_/g;
    $outputLockFile = File::Spec->catfile($parent, ".lotus3.$base.lock");
    open my $lfh, ">>", $outputLockFile or die "Cannot open output lock $outputLockFile: $!\n";
    unless (flock($lfh, LOCK_EX | LOCK_NB)) {
        die "Output directory appears to be in use by another LotuS3 run: $target_outdir\nLock file: $outputLockFile\n";
    }
    print {$lfh} "LotuS3 lock held by PID $$ since " . scalar(localtime) . "\n";
    $outputLockFH = $lfh;
}

sub release_output_lock {
    return unless defined $outputLockFH;
    flock($outputLockFH, LOCK_UN);
    close $outputLockFH;
    undef $outputLockFH;
    unlink $outputLockFile if defined $outputLockFile && $outputLockFile ne "" && -e $outputLockFile;
}

sub file_signature {
    my ($path) = @_;
    return "missing" unless defined $path && $path ne "" && -e $path;
    my @st = stat($path);
    return "size=$st[7];mtime=$st[9]";
}

sub validate_reference_databases {
    my @problems;
    my @warnings;
    if ($doBlasting >= 1 && $doBlasting != 3) {
        push @problems, "Similarity-based taxonomy is enabled, but no reference FASTA was selected" unless @TAX_REFDB;
        push @problems, "Reference FASTA/taxonomy file counts differ (" . scalar(@TAX_REFDB) . " FASTA vs " . scalar(@TAX_RANKS) . " taxonomy files)"
            unless @TAX_REFDB == @TAX_RANKS;
    }
    for (my $i=0; $i<@TAX_REFDB; $i++) {
        my $db  = $TAX_REFDB[$i]  // "";
        my $tax = $TAX_RANKS[$i]  // "";
        my $db_unsafe = _unsafe_shell_token_reason($db);
        my $tax_unsafe = _unsafe_shell_token_reason($tax);
        push @problems, "Unsafe reference FASTA path '$db': $db_unsafe" if $db ne "" && $db_unsafe ne "";
        push @problems, "Unsafe taxonomy path '$tax': $tax_unsafe" if $tax ne "" && $tax_unsafe ne "";
        if ($doBlasting == 3) {
            push @problems, "SINTAX/UTAX reference directory missing: $db" unless $db ne "" && -d $db;
            next;
        }
        push @problems, "Reference FASTA path is empty for database entry $i" if $doBlasting >= 1 && $db eq "";
        push @problems, "Taxonomy path is empty for database entry $i" if $doBlasting >= 1 && $doBlasting != 3 && $tax eq "";
        push @problems, "Reference FASTA missing or empty: $db" if $db ne "" && !-s $db;
        push @problems, "Taxonomy file missing or empty: $tax" if $tax ne "" && !-s $tax;
        push @problems, "Compressed taxonomy files are not supported by downstream taxonomy readers: $tax" if $tax =~ /\.gz$/i;
    }
    if ($TaxOnly eq "0" && (($forceRefChim && ($noChimChk == 0 || $noChimChk == 2) && ($UCHIME_REFDB eq "" || !-s $UCHIME_REFDB)) ||
        ($UCHIME_REFDB ne "" && !-s $UCHIME_REFDB))) {
        my $msg = "UCHIME reference missing or empty: " . ($UCHIME_REFDB eq "" ? "<not configured>" : $UCHIME_REFDB);
        if ($forceRefChim && ($noChimChk == 0 || $noChimChk == 2)) { push @problems, $msg; }
        else { push @warnings, "$msg (reference chimera filtering will be skipped when it is optional)"; }
    }
    if ($TaxOnly eq "0" && $doPhiX && ($CONT_REFDB_PHIX eq "" || !-s $CONT_REFDB_PHIX)) {
        push @problems, "PhiX removal is enabled, but the PhiX reference is missing or empty: " . ($CONT_REFDB_PHIX eq "" ? "<not configured>" : $CONT_REFDB_PHIX);
    }
    if ($doBlasting == 2) { # lambda3
        for my $db (@TAX_REFDB) {
            next unless defined $db && $db ne "";
            my $idx = "$db.lba.gz";
            push @warnings, "Lambda index not found for $db (expected $idx); this is non-fatal because the index may be created during the pipeline run" unless -s $idx;
        }
    }
    if (@warnings) {
        my $msg = "Reference database validation warnings:
" . join("
", map { " - $_" } @warnings) . "
";
        printL($msg, "w");
    }
    if (@problems) {
        my $msg = "Reference database validation failed:
" . join("
", map { " - $_" } @problems) . "
";
        if ($strictMode) { printL($msg, 55); } else { printL($msg, "w"); }
    }
}

sub validate_option_combinations {
    my @problems;
    if ($TaxOnly eq "0") {
        push @problems, "Missing input (-i)" unless defined($input) && $input ne "";
        push @problems, "Missing mapping file (-m)" unless defined($mapFile) && $mapFile ne "" && -f $mapFile;
    }
    if (@inputArray && !(@inputArray == 1 && -d $inputArray[0])) {
        for my $path (@inputArray) {
            push @problems, "Input does not exist or is not a regular file: $path" unless -f $path;
        }
    }
    if ($TaxOnly ne "0" && -f $TaxOnly) {
        # Taxonomy-only input bypasses sdm, so retain a minimal one-record format check.
        my ($n,$p,$w) = fasta_validation_scan($TaxOnly, 1);
        push @problems, @$p;
        printL("Taxonomy-only FASTA validation warnings:\n" . join("\n", map { " - $_" } @$w) . "\n", "w") if @$w;
    } elsif ($TaxOnly ne "0" && $TaxOnly ne "1") {
        push @problems, "-taxOnly input does not exist or is not a regular FASTA file: $TaxOnly";
    }
    if (substr($ampliconType,0,3) eq "ITS" && $doBlasting < 1) {
        push @problems, "ITS amplicon mode requires similarity-based taxonomy; current -taxAligner disables it";
    }
    if (substr($ampliconType,0,3) eq "ITS" && $refDBwanted =~ /^(?:SLV|GG|GG2|KSGP|HITDB)$/i) {
        push @problems, "Marker/reference DB incompatibility: ITS amplicon type should not use a 16S/prokaryotic reference DB ($refDBwanted); use UNITE or a compatible custom DB";
    }
    if ($ampliconType eq "SSU" && $refDBwanted =~ /^(?:UNITE)$/i) {
        push @problems, "Marker/reference DB incompatibility: SSU/16S profile should not use UNITE ITS reference DB";
    }
    if ($doITSx == 1 && !$itsxBin) {
        push @problems, "ITSx extraction requested but ITSx binary is not configured";
    }
    if ($doVXTR != 0 && !$vxtrBin) {
        push @problems, "VXtractor requested but VXtractor binary is not configured";
    }
    push @problems, "-threads must be a positive integer (got $uthreads)" unless $uthreads =~ /^\d+$/ && $uthreads > 0;
    push @problems, "-sdmThreads must be a positive integer (got $sdmThreads)" unless $sdmThreads =~ /^\d+$/ && $sdmThreads > 0;
    push @problems, "-id must be greater than 0 and at most 1 (got $id_OTU)" unless $id_OTU > 0 && $id_OTU <= 1;
    push @problems, "-backmap_id must be greater than 0 and at most 1 (got $backMapID)" unless $backMapID == -1 || ($backMapID > 0 && $backMapID <= 1);
    for my $range_check (
        ["-rdp_thr", $RDPCONF], ["-sintax_thr", $utaxConf], ["-LCA_frac", $LCAfraction],
        ["-LCA_cover", $LCAcover], ["length tolerance", $lengthTolerance]
    ) {
        push @problems, "$range_check->[0] must be between 0 and 1 (got $range_check->[1])"
            unless $range_check->[1] >= 0 && $range_check->[1] <= 1;
    }
    push @problems, "-chim_skew must be greater than 0 (got $chimera_absskew)" unless $chimera_absskew > 0;
    push @problems, "LCA minimum alignment length must be positive (got $LCAminAliLen)" unless $LCAminAliLen > 0;
    push @problems, "Minimum BLAST bit score cannot be negative (got $minBit)" unless $minBit >= 0;
    push @problems, "Minimum BLAST e-value must be greater than 0 (got $minEval)" unless $minEval > 0;
    push @problems, "-GAminAmpli cannot be negative" if $GAminAmpli < 0;
    push @problems, "-GAmaxAmpli cannot be negative" if $GAmaxAmpli < 0;
    push @problems, "-GAminAmpli cannot exceed -GAmaxAmpli" if $GAmaxAmpli > 0 && $GAminAmpli > $GAmaxAmpli;
    push @problems, "Unsupported -platform '$platform'" unless $platform =~ /^(?:miseq|hiseq|454|pacbio|pacbio_ga|aviti)$/;
    push @problems, "Unsupported -amplicon_type '$ampliconType'" unless $ampliconType =~ /^(?:SSU|LSU|ITS|ITS1|ITS2|CUSTOM)$/;
    push @problems, "Unsupported -tax_group '$organism'" unless $organism =~ /^(?:bacteria|fungi|eukarya)$/;
    push @problems, "-derepMin has invalid syntax '$dereplicate_minsize'"
        unless defined($dereplicate_minsize) && $dereplicate_minsize =~ /^\d+(?::\d+)?(?:,\d+(?::\d+)?)*$/;
    push @problems, "-vsearch_iddef must be between 0 and 4" if defined($vsearch_iddef) && ($vsearch_iddef < 0 || $vsearch_iddef > 4);
    push @problems, "-forwardPrimer contains non-IUPAC characters" if $fwdPrimSeq ne "" && $fwdPrimSeq =~ /[^ACGTRYSWKMBDHVNUI]/i;
    push @problems, "-reversePrimer contains non-IUPAC characters" if $revPrimSeq ne "" && $revPrimSeq =~ /[^ACGTRYSWKMBDHVNUI]/i;
    if ($TaxOnly eq "0") {
        push @problems, "VSEARCH clustering was selected but VSEARCH is unavailable" if $ClusterPipe == 8 && !-f $VSBinOri;
        push @problems, "UPARSE/UNOISE clustering was selected but USEARCH is unavailable" if ($ClusterPipe == 1 || $ClusterPipe == 6) && !-f $usBin;
        push @problems, "DADA2 clustering was selected but its R script is unavailable" if $ClusterPipe == 7 && !-f $dada2Scr;
        push @problems, "DADA2 clustering was selected but Rscript is unavailable" if $ClusterPipe == 7 && !-f $Rscript;
        push @problems, "SWARM clustering was selected but SWARM is unavailable" if $ClusterPipe == 2 && !-f $swarmBin;
        push @problems, "CD-HIT clustering was selected but CD-HIT is unavailable" if $ClusterPipe == 3 && !-f $cdhitBin;
        push @problems, "Minimap2 backmapping is enabled but minimap2 is unavailable" if $useMini4map == 1 && !-f $mini2Bin;
        push @problems, "VSEARCH/USEARCH backmapping is enabled but neither executable is available" if $useMini4map == 0 && !-f $VSBin;
        push @problems, "LULU is enabled but its R script is unavailable" if $doLULU && !-f $LULUscript;
        push @problems, "LULU is enabled but Rscript is unavailable" if $doLULU && !-f $Rscript;
        push @problems, "FastTree phylogeny requires MAFFT" if $buildPhylo == 1 && !-f $mafftBin;
        push @problems, "FastTree phylogeny requires FastTree" if $buildPhylo == 1 && !-f $fasttreeBin;
        push @problems, "IQ-TREE phylogeny requires MAFFT" if $buildPhylo == 2 && !-f $mafftBin;
        push @problems, "IQ-TREE phylogeny requires IQ-TREE" if $buildPhylo == 2 && !-f $iqTreeBin;
    }
    push @problems, "-buildPhylo must be 0, 1, or 2" unless $buildPhylo =~ /^[012]$/;
    push @problems, "-useMini4map must be 0 or 1" unless $useMini4map =~ /^[01]$/;
    if ($doRDPing > 0) {
        my $rdp_path = $mjar ne "" ? $mjar : $rdpjar ne "" ? $rdpjar : ($ENV{RDP_JAR_PATH} // "");
        push @problems, "RDP taxonomy is selected but no readable RDP classifier/JAR is configured" unless $rdp_path ne "" && -f $rdp_path;
        push @problems, "RDP taxonomy is selected but Java is unavailable" unless command_exists("java");
        my $rdp_unsafe = _unsafe_shell_token_reason($rdp_path);
        push @problems, "Unsafe RDP classifier path '$rdp_path': $rdp_unsafe" if $rdp_path ne "" && $rdp_unsafe ne "";
    }
    if ($taxExcludeGrep ne "") {
        my $ok = eval { qr/$taxExcludeGrep/; 1 };
        push @problems, "Invalid regular expression in -taxExcludeGrep: $@" unless $ok;
    }
    if (@problems) {
        my $msg = "Option/dependency combination validation failed:\n" . join("\n", map { " - $_" } @problems) . "\n";
        if ($strictMode) { printL($msg, 64); } else { printL($msg, "w"); }
    }
}


sub _option_was_provided {
    my (@names) = @_;
    for my $n (@names) {
        return 1 if exists $userProvidedOption{$n};
    }
    return 0;
}

sub _unsafe_shell_token_reason {
    my ($value) = @_;
    return "contains a NUL or line break" if defined($value) && $value =~ /[\0\r\n]/;
    return "contains shell-control characters" if defined($value) && $value =~ /[;&|`\$<>]/;
    return "contains whitespace, which this pipeline's legacy command layer cannot safely preserve" if defined($value) && $value =~ /\s/;
    return "";
}

sub validate_cli_safety {
    if (defined($ClusterPipe_pre) && $ClusterPipe_pre =~ /^(?:DNACLUST|4)$/i) {
        die "DNACLUST/reference-based OTU clustering has been removed. Choose UPARSE, VSEARCH, CD-HIT, SWARM, UNOISE, or DADA2.\n";
    }
    my @values;
    push @values, map { ["input path", $_] } grep { defined($_) && $_ ne "" } split(/,/, $input // "");
    push @values, map { ["quality path", $_] } grep { defined($_) && $_ ne "" } split(/,/, $inq // "");
    push @values,
        ["output path", $outdir], ["mapping path", $mapFile], ["barcode path", $barcodefile],
        ["SDM option path", $sdmOpt], ["temporary path", $lotus_tempDir], ["configuration path", $lotusCfg],
        ["dependency report path", $depReportFile], ["manifest path", $manifestFile],
        ["off-target database path", $custContamCheckDB], ["in-target database path", $custKeepOTUDB],
        ["reference chimera database path", $chimRefDBcust];
    push @values, ["taxonomy-only path", $TaxOnly] if defined($TaxOnly) && $TaxOnly ne "0";
    push @values, ["custom reference database", $refDBwanted] if defined($refDBwanted) && -e $refDBwanted;
    for my $item (@values) {
        my ($label,$value) = @$item;
        next unless defined($value) && $value ne "";
        my $reason = _unsafe_shell_token_reason($value);
        die "Unsafe $label '$value': $reason. Use a path without whitespace or shell metacharacters.\n" if $reason ne "";
    }
    if (defined($flashCustom) && $flashCustom ne "" && $flashCustom =~ /[\0\r\n;&|`\$<>]/) {
        die "Unsafe -flash_param value: shell-control characters are not allowed.\n";
    }
}

sub validate_runtime_path_safety {
    my @paths = (
        ["Rscript",$Rscript], ["sdm",$sdmBin], ["LCA",$LCABin], ["vsearch",$VSBin],
        ["usearch",$usBin], ["DADA2 script",$dada2Scr], ["LULU script",$LULUscript],
        ["ASV clustering script",$ASVclscript], ["phyloseq script",$phyloLnk], ["swarm",$swarmBin],
        ["CD-HIT",$cdhitBin], ["minimap2",$mini2Bin], ["RDP",$rdpjar], ["multi-RDP",$mjar],
        ["BLAST",$blastBin], ["makeblastdb",$mkBldbBin], ["lambda3",$lambda3Bin],
        ["mafft",$mafftBin], ["clustalo",$clustaloBin], ["FastTree",$fasttreeBin], ["IQ-TREE",$iqTreeBin],
        ["FLASH",$flashBin], ["ITSx",$itsxBin], ["hmmsearch",$hmmsrchBin], ["VXtractor",$vxtrBin]
    );
    for my $item (@paths) {
        my ($label,$value) = @$item;
        next unless defined($value) && $value ne "";
        my $reason = _unsafe_shell_token_reason($value);
        printL "Unsafe configured $label path '$value': $reason.\n", 64 if $reason ne "";
    }
}

sub _set_profile_default {
    my ($value_ref, $value, @option_names) = @_;
    return if _option_was_provided(@option_names);
    $$value_ref = $value;
}

sub apply_profile_preset {
    my $p = lc($profilePreset // "");
    $p =~ s/-/_/g;
    my %valid = map { $_ => 1 } qw(16s_otu 16s_asv its_otu its_asv longread_16s taxonomy_only);
    if (!$valid{$p}) {
        die "Unknown -profile '$profilePreset'. Supported presets: 16S_otu, 16S_asv, ITS_otu, ITS_asv, longread_16S, taxonomy_only\n";
    }
    if ($p eq "16s_otu") {
        _set_profile_default(\$ClusterPipe_pre, "UPARSE", qw(CL cl clustering UP UPARSE));
        _set_profile_default(\$ampliconType, "SSU", qw(amplicon_type));
        _set_profile_default(\$organism, "bacteria", qw(tax_group));
        _set_profile_default(\$refDBwanted, "KSGP", qw(refDB));
        _set_profile_default(\$noChimChk, 0, qw(deactivateChimeraCheck));
        _set_profile_default(\$mergePreCluster, 1, qw(mergePreClusterReads));
    } elsif ($p eq "16s_asv") {
        _set_profile_default(\$ClusterPipe_pre, "DADA2", qw(CL cl clustering UP UPARSE));
        _set_profile_default(\$ampliconType, "SSU", qw(amplicon_type));
        _set_profile_default(\$organism, "bacteria", qw(tax_group));
        _set_profile_default(\$refDBwanted, "KSGP", qw(refDB));
        _set_profile_default(\$noChimChk, 0, qw(deactivateChimeraCheck));
        _set_profile_default(\$mergePreCluster, 0, qw(mergePreClusterReads));
        _set_profile_default(\$backMapID, 0.99, qw(backmap_id));
    } elsif ($p eq "its_otu") {
        _set_profile_default(\$ClusterPipe_pre, "UPARSE", qw(CL cl clustering UP UPARSE));
        _set_profile_default(\$ampliconType, "ITS", qw(amplicon_type));
        _set_profile_default(\$organism, "fungi", qw(tax_group));
        _set_profile_default(\$refDBwanted, "UNITE", qw(refDB));
        _set_profile_default(\$doBlasting_pre, "vsearch", qw(doBlast simBasedTaxo taxAligner));
        _set_profile_default(\$doITSx, 1, qw(ITSx itsextraction));
        _set_profile_default(\$noChimChk, 0, qw(deactivateChimeraCheck));
    } elsif ($p eq "its_asv") {
        _set_profile_default(\$ClusterPipe_pre, "DADA2", qw(CL cl clustering UP UPARSE));
        _set_profile_default(\$ampliconType, "ITS", qw(amplicon_type));
