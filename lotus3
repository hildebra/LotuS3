sub selftest_config_values {
    my ($cfg) = @_;
    my %values;
    open my $fh, "<", $cfg or return \%values;
    while (my $line = <$fh>) {
        $line =~ s/[\r\n]+$//;
        next if $line =~ /^\s*(?:#|$)/;
        if ($line =~ /^\s*(\S+)\s+(.+?)\s*$/) {
            my ($key,$value) = ($1,$2);
            $value =~ s/^['"]|['"]$//g;
            $values{$key} = $value;
        }
    }
    close $fh;
    return \%values;
}

sub selftest_resolve_dependency {
    my ($cfg_values, $name) = @_;
    return command_exists("Rscript") // "" if $name eq "Rscript";
    return command_exists("java") // "" if $name eq "java";
    if ($name eq "RDP") {
        for my $candidate ($ENV{RDP_JAR_PATH}, $cfg_values->{multiRDPjar}, $cfg_values->{RDPjar}) {
            next unless defined($candidate) && $candidate ne "";
            my $local = File::Spec->catfile($RealBin, $candidate);
            return abs_path($local) // $local if -f $local;
            return abs_path($candidate) // $candidate if -f $candidate;
            my $found = command_exists($candidate);
            return $found if $found;
        }
        return "";
    }
    my %key_for = (
        sdm => "sdm", vsearch => "vsearch", lambda3 => "lambda3", LCA => "LCA",
        flash => "flashBin", dada2R => "dada2R"
    );
    my $key = $key_for{$name} // $name;
    my $candidate = $cfg_values->{$key} // "";
    return "" if $candidate eq "";
    my $local = File::Spec->catfile($RealBin, $candidate);
    return abs_path($local) // $local if -f $local;
    return abs_path($candidate) // $candidate if -f $candidate;
    return command_exists($candidate) // "";
}

sub selftest_run_case {
    my ($script, $case, $report_ref, $selftest_threads, $cfg) = @_;
    my $out = $case->{out};
    my $root = dirname($out);
    my $log_root = File::Spec->catdir($root, "selftest_logs");
    ensure_dir($log_root) unless -d $log_root;

    my $run_log = File::Spec->catfile($log_root, "$case->{name}_pipeline.log");

    if (-e $out) {
        push @$report_ref, "Output directory already exists; refusing to overwrite in self-test: $out";
        return 0;
    }

    my $cfg_values = selftest_config_values($cfg);
    for my $tool (@{$case->{required_tools}}) {
        my $path = selftest_resolve_dependency($cfg_values, $tool);
        if ($path eq "") {
            push @$report_ref, "Required self-test dependency is missing for $case->{name}: $tool";
            return 0;
        }
        push @$report_ref, "Required dependency OK: $tool -> $path";
    }

    my $run_dep_report = File::Spec->catfile($out, "LotuSLogS", "dependency_report.txt");
    my $run_manifest   = File::Spec->catfile($out, "LotuSLogS", "run_manifest.txt");
    my @run = ($^X, $script, @{$case->{args}}, "-c", $cfg, "-o", $out, "-t", $selftest_threads,
               "--dependencyReport", $run_dep_report, "--manifest", $run_manifest);

    push @$report_ref, "Pipeline command: " . join(" ", map { shell_quote($_) } @run);
    my $run_stat = run_command_capture($run_log, @run);
    push @$report_ref, "Pipeline exit status: $run_stat";
    push @$report_ref, "Pipeline log: $run_log";
    if ($run_stat != 0) {
        push @$report_ref, "Pipeline execution failed.";
        return 0;
    }

    return selftest_validate_output($case, $report_ref);
}

sub run_command_capture {
    my ($log_file, @cmd) = @_;
    my $pid = fork();
    die "Cannot fork self-test command: $!\n" unless defined $pid;
    if ($pid == 0) {
        open STDOUT, ">", $log_file or die "Cannot write $log_file: $!\n";
        open STDERR, ">&", STDOUT or die "Cannot redirect STDERR to $log_file: $!\n";
        exec { $cmd[0] } @cmd or do {
            print STDERR "Cannot exec @cmd: $!\n";
            exit 127;
        };
    }
    waitpid($pid, 0);
    return 127 if $? == -1;
    return 128 + ($? & 127) if $? & 127;
    return $? >> 8;
}

sub selftest_validate_output {
    my ($case, $report_ref) = @_;
    my $out = $case->{out};
    my @required = (
        File::Spec->catfile($out, "OTU.fna"),
        File::Spec->catfile($out, "OTU.txt"),
        File::Spec->catfile($out, "OTU.biom"),
        File::Spec->catfile($out, $case->{expected_tax}),
        File::Spec->catfile($out, "LotuSLogS", "LotuS_run.log"),
        File::Spec->catfile($out, "LotuSLogS", "LotuS_cmds.log"),
        File::Spec->catfile($out, "LotuSLogS", "dependency_report.txt"),
        File::Spec->catfile($out, "LotuSLogS", "run_manifest.txt"),
        File::Spec->catfile($out, "LotuS_output_schema_version.txt"),
    );
    my @missing;
    for my $f (@required) {
        push @missing, $f unless -s $f;
    }
    if (@missing) {
        push @$report_ref, "Missing or empty expected output(s):", map { "  - $_" } @missing;
        return 0;
    }

    my ($otu_count,$fa_problems,$fa_warnings,$fasta_ids) = fasta_validation_scan(File::Spec->catfile($out, "OTU.fna"), 1000000);
    if (@$fa_problems) {
        push @$report_ref, "Invalid OTU.fna:", map { "  - $_" } @$fa_problems;
        return 0;
    }
    my ($table,$table_ids);
    my $table_ok = eval { ($table,$table_ids) = readOTUmat(File::Spec->catfile($out, "OTU.txt")); 1 };
    if (!$table_ok) {
        push @$report_ref, "Invalid OTU.txt: $@";
        return 0;
    }
    my $table_rows = scalar(@$table_ids);
    push @$report_ref, "Output validation: OTU.fna entries = $otu_count; OTU.txt data rows = $table_rows";
    if ($otu_count < 1 || $table_rows < 1) {
        push @$report_ref, "Expected at least one OTU/ASV sequence and one abundance-table row.";
        return 0;
    }
    my %fasta_id = map { $_ => 1 } @$fasta_ids;
    my %table_id = map { $_ => 1 } @$table_ids;
    my @only_fasta = grep { !exists $table_id{$_} } keys %fasta_id;
    my @only_table = grep { !exists $fasta_id{$_} } keys %table_id;
    if (@only_fasta || @only_table) {
        push @$report_ref, "OTU.fna and OTU.txt IDs are inconsistent (FASTA-only=" . scalar(@only_fasta) . ", table-only=" . scalar(@only_table) . ")";
        return 0;
    }

    my $biom = File::Spec->catfile($out, "OTU.biom");
    open my $bfh, "<", $biom or do { push @$report_ref, "Could not read BIOM output: $biom: $!"; return 0; };
    my $biom_head = do { local $/; <$bfh> };
    close $bfh;
    my $biom_obj = eval { JSON::PP::decode_json($biom_head) };
    if (!$biom_obj || ref($biom_obj) ne "HASH") {
        push @$report_ref, "BIOM output is not valid JSON: $biom ($@)";
        return 0;
    }
    if (($biom_obj->{LotuS_output_schema_version} // "") ne $LotuS_output_schema_version) {
        push @$report_ref, "BIOM output does not contain expected LotuS_output_schema_version metadata: $biom";
        return 0;
    }
    if (($biom_obj->{generated_by} // "") !~ /^LotuS/) {
        push @$report_ref, "BIOM output does not contain expected LotuS generated_by metadata: $biom";
        return 0;
    }
    my $shape = $biom_obj->{shape};
    my $rows = $biom_obj->{rows};
    my $columns = $biom_obj->{columns};
    my $data = $biom_obj->{data};
    if (ref($shape) ne "ARRAY" || @$shape != 2 || $shape->[0] != $table_rows ||
        ref($rows) ne "ARRAY" || @$rows != $shape->[0] || ref($columns) ne "ARRAY" || @$columns != $shape->[1] ||
        ref($data) ne "ARRAY" || @$data != $shape->[0] || grep { ref($_) ne "ARRAY" || @$_ != $shape->[1] } @$data) {
        push @$report_ref, "BIOM shape/row/column/data dimensions are inconsistent: $biom";
        return 0;
    }
    my %biom_ids = map { ($_->{id} // "") => 1 } @$rows;
    if (grep { !exists $biom_ids{$_} } @$table_ids) {
        push @$report_ref, "BIOM row IDs do not match OTU.txt IDs: $biom";
        return 0;
    }
    my @table_samples = sort keys %$table;
    my %biom_samples = map { ($_->{id} // "") => 1 } @$columns;
    if (@table_samples != @$columns || grep { !exists $biom_samples{$_} } @table_samples) {
        push @$report_ref, "BIOM column IDs do not match OTU.txt sample IDs: $biom";
        return 0;
    }
    for (my $ri = 0; $ri < @$rows; $ri++) {
        my $otu = $rows->[$ri]{id} // "";
        for (my $ci = 0; $ci < @$columns; $ci++) {
            my $sample = $columns->[$ci]{id} // "";
            my $expected = $table->{$sample}{$otu};
            if (!defined($expected) || $data->[$ri][$ci] != $expected) {
                push @$report_ref, "BIOM count does not match OTU.txt for $otu/$sample";
                return 0;
            }
        }
    }

    my $manifest = File::Spec->catfile($out, "LotuSLogS", "run_manifest.txt");
    open my $mfh, "<", $manifest or do { push @$report_ref, "Could not read manifest: $manifest: $!"; return 0; };
    my $manifest_text = do { local $/; <$mfh> };
    close $mfh;
    if ($manifest_text !~ /^LotuS_output_schema_version:\s*\Q$LotuS_output_schema_version\E$/m ||
        $manifest_text !~ /^Version:\s*\Q$selfID\E$/m) {
        push @$report_ref, "Run manifest is missing expected version/schema metadata: $manifest";
        return 0;
    }

    my $main_log = File::Spec->catfile($out, "LotuSLogS", "LotuS_run.log");
    if (-s $main_log) {
        open my $lfh, "<", $main_log;
        my $log_txt = do { local $/; <$lfh> };
        close $lfh;
        if ($log_txt =~ /(?:CMD failed|Aborting LotuS3 run|Error:)/i) {
            push @$report_ref, "Main log contains failure-like text; inspect $main_log";
            return 0;
        }
    }

    push @$report_ref, "Output validation passed for $case->{name}: $out";
    return 1;
}

