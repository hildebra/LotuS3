sub printL($ $) {
    my ( $msg, $stat ) = @_;
	if ( defined $stat && lc($stat) eq "w" ) {
		$msg = "WARNING:: $msg";
		#die "$msg";
		print LOG $msg if defined fileno(LOG);
        finWarn($msg);
        return;
    }
    print $msg if ($verbosity > 0) ;
    if ( $mainLogFile ne "" && defined fileno(LOG) ) {
        print LOG $msg;
    }
    if ( defined $stat && $stat ne "0" ) { 
		#print "Error: $msg\n";# if ($verbosity < 1) ; #print in any case, since exiting on this message
		print "\n%@#%@#%@#%@%@#@%#@%#@#%@#%@#%@#@%#@%#@%#@#%@#%@#%@##\n      LotuS3 encounterend an error:\n$msg\n\nFirst check if the last error occurred  in a program called by LotuS3 \n\"tail $progOutPut\"\n, if there is an obvious solution (e.g. external program breaking, this we can't fix). To see (and execute) the last commands by the pipeline, run \n\"tail $cmdLogFile\".\nIn case you decide to contact us on \"https://github.com/hildebra/lotus3/\", please try to include information from these approaches in your message, this will decrease our response time. Thank you.\n%@#%@#%@#%@%@#@%#@%#@#%@#%@#%@#@%#@%#@%#@#%@#%@#%@##\n";
		exit($stat); 
	}
}

sub detect_available_cpus {
    # Prefer GNU nproc because it respects CPU affinity/cgroup constraints on Linux,
    # which is usually what matters for cluster jobs and containers.
    my @checks = (
        sub {
            my $nproc = command_exists("nproc") or return 0;
            my $out = `$nproc 2>/dev/null`;
            chomp $out;
            return int($out || 0);
        },
        sub {
            my $getconf = command_exists("getconf") or return 0;
            my $out = `$getconf _NPROCESSORS_ONLN 2>/dev/null`;
            chomp $out;
            return int($out || 0);
        },
        sub {
            my $sysctl = command_exists("sysctl") or return 0;
            my $out = `$sysctl -n hw.ncpu 2>/dev/null`;
            chomp $out;
            return int($out || 0);
        },
    );

    for my $check (@checks) {
        my $n = eval { $check->() } || 0;
        return $n if $n > 0 && $n < 10000;
    }
    return 1;
}

sub command_exists {
    my ($cmd) = @_;
    return unless defined $cmd && $cmd ne "";
    if ($cmd =~ m{/}) {
        return $cmd if -x $cmd;
        return;
    }
    for my $dir (split /:/, ($ENV{PATH} // "")) {
        my $path = File::Spec->catfile($dir, $cmd);
        return $path if -x $path;
    }
    return;
}

sub ensure_dir {
    my ($dir) = @_;
    die "Refusing to create an undefined/empty directory path\n" unless defined $dir && $dir ne "";
    make_path($dir) unless -d $dir;
    die "Failed to create directory $dir: $!\n" unless -d $dir;
}

sub safe_remove_tree {
    my ($path, $label) = @_;
    $label //= "path";
    return unless defined $path && $path ne "" && -e $path;

    die "Refusing to recursively remove symbolic-link $label: $path\n" if -l $path;

    my $abs = abs_path($path) // $path;
    die "Refusing to remove unsafe $label path: $abs\n"
        if $abs eq "/" || $abs eq "." || $abs eq ".." || $abs =~ m{^/+$};
    die "Refusing to remove very short $label path: $abs\n"
        if length($abs) < 8;
    die "Refusing to recursively remove a file as $label: $abs\n"
        if -f $abs;
    die "Refusing to recursively remove non-directory $label: $abs\n"
        unless -d $abs;
    my $cwd = abs_path(".") // File::Spec->rel2abs(".");
    my $script_root = abs_path($RealBin) // File::Spec->rel2abs($RealBin);
    my $home = defined($ENV{HOME}) && $ENV{HOME} ne "" ? (abs_path($ENV{HOME}) // File::Spec->rel2abs($ENV{HOME})) : "";
    die "Refusing to remove $label because it is the current working directory or one of its parents: $abs\n"
        if $cwd eq $abs || index($cwd . "/", $abs . "/") == 0;
    die "Refusing to remove $label because it is the LotuS installation directory or one of its parents: $abs\n"
        if $script_root eq $abs || index($script_root . "/", $abs . "/") == 0;
    die "Refusing to remove the home directory as $label: $abs\n"
        if $home ne "" && $home eq $abs;

    remove_tree($abs, { safe => 1, error => \my $err });
    if (@$err) {
        my @msgs;
        for my $diag (@$err) {
            my ($file, $message) = %$diag;
            push @msgs, "$file: $message";
        }
        die "Failed to remove $label $abs:\n" . join("\n", @msgs) . "\n";
    }
}

sub _path_is_same_or_parent {
    my ($parent, $child) = @_;
    return 0 unless defined($parent) && defined($child) && $parent ne "" && $child ne "";
    $parent =~ s{/+$}{};
    $child =~ s{/+$}{};
    return 1 if $parent eq $child;
    return index($child . "/", $parent . "/") == 0 ? 1 : 0;
}

sub _assert_safe_temp_directory_target {
    my ($path) = @_;
    my $abs = -e $path ? (abs_path($path) // $path) : File::Spec->rel2abs($path);
    die "Refusing unsafe temporary directory path: $abs\n"
        if $abs eq "/" || $abs eq "." || $abs eq ".." || $abs =~ m{^/+$} || length($abs) < 8;
    my $cwd = abs_path(".") // File::Spec->rel2abs(".");
    my $script_root = abs_path($RealBin) // File::Spec->rel2abs($RealBin);
    my $output_root = abs_path($outdir) // File::Spec->rel2abs($outdir);
    my $home = defined($ENV{HOME}) && $ENV{HOME} ne "" ? (abs_path($ENV{HOME}) // File::Spec->rel2abs($ENV{HOME})) : "";
    die "Temporary directory must not be the current working directory or one of its parents: $abs\n"
        if _path_is_same_or_parent($abs, $cwd);
    die "Temporary directory must not be the LotuS installation directory or one of its parents: $abs\n"
        if _path_is_same_or_parent($abs, $script_root);
    die "Temporary directory must not contain or equal the output directory: $abs\n"
        if _path_is_same_or_parent($abs, $output_root);
    die "Temporary directory must not be the home directory: $abs\n"
        if $home ne "" && $abs eq $home;
    return $abs;
}

sub _legacy_lotus_temp_entry {
    my ($name) = @_;
    return 1 if $name =~ /^(?:
        demulti(?:\..*)? |
        derep(?:\..*)? |
        otu_seeds(?:\..*)? |
        finalOTU(?:\..*)? |
        filtered\.fa | tmp_otu\.fa | tmp1\.fa | uniqueSeqs\.fna | uparse\.fa |
        clusters\.uc | otus(?:\..*)? | dada2(?:\..*)? | dada2_p\d+_err[FRM]\.pdf |
        chimeras_(?:denovo|ref)\.fa | lulu_match_list\.txt(?:\.rm)? | RDPotus\.tax |
        tax(?:\..*)? | add\.(?:uc|paf) | rests\.(?:uc|paf) | tmpUCs\.\d+\.uct |
        otus4blast\.tmp | blast4dire\.blast | taxonomy_only_input\.fna | ASVcl\.hits |
        IQ(?:\..*)? | itsx | demultiplexed
    )$/ix;
    return 0;
}

sub _classify_legacy_lotus_temp {
    my ($dir) = @_;
    opendir my $dh, $dir or die "Cannot inspect temporary directory $dir: $!\n";
    my @entries = grep { $_ ne "." && $_ ne ".." } readdir($dh);
    closedir $dh;
    my (@known, @unknown);
    for my $entry (@entries) {
        my $full = File::Spec->catfile($dir, $entry);
        if (!-l $full && _legacy_lotus_temp_entry($entry)) {
            push @known, $entry;
        } else {
            push @unknown, $entry;
        }
    }
    return (\@known, \@unknown, \@entries);
}

sub prepare_temp_directory {
    die "Temporary directory is undefined\n" unless defined($lotus_tempDir) && $lotus_tempDir ne "";
    die "Refusing symbolic-link temporary directory: $lotus_tempDir\n" if -l $lotus_tempDir;
    die "Temporary path exists but is not a directory: $lotus_tempDir\n" if -e $lotus_tempDir && !-d $lotus_tempDir;
    _assert_safe_temp_directory_target($lotus_tempDir);

    $tempDirCreatedMarker = File::Spec->catfile($lotus_tempDir, ".lotus3_tmp_owned");
    if (-d $lotus_tempDir) {
        if (-s $tempDirCreatedMarker) {
            open my $mfh, "<", $tempDirCreatedMarker or die "Cannot read temporary-directory marker $tempDirCreatedMarker: $!\n";
            my $marker = do { local $/; <$mfh> };
            close $mfh;
            my $expected = abs_path($outdir) // File::Spec->rel2abs($outdir);
            die "Temporary directory marker does not belong to output directory $expected; refusing cleanup: $lotus_tempDir\n"
                unless defined($marker) && $marker =~ /^Output:\s*\Q$expected\E\s*$/m;
            safe_remove_tree($lotus_tempDir, "temporary directory");
        } else {
            my ($known, $unknown, $entries) = _classify_legacy_lotus_temp($lotus_tempDir);
            if (@$entries && @$known == 0) {
                my $examples = join(", ", @$unknown[0 .. ($#$unknown < 4 ? $#$unknown : 4)]);
                die "Temporary directory contains no recognizable LotuS intermediate files and has no ownership marker: $lotus_tempDir\nUnrecognized entries: $examples\n";
            }
            if (@$entries && @$unknown && @$known < 2) {
                my $examples = join(", ", @$unknown[0 .. ($#$unknown < 4 ? $#$unknown : 4)]);
                die "Temporary directory is ambiguous: only one legacy LotuS intermediate was recognized alongside unrelated entries: $lotus_tempDir\nUnrecognized entries: $examples\n";
            }
            if (@$entries && !@$unknown) {
                printL("Recognized a marker-less temporary directory from an older LotuS run; clearing " . scalar(@$known) . " legacy intermediate(s): $lotus_tempDir\n", "w");
                safe_remove_tree($lotus_tempDir, "legacy LotuS temporary directory");
            } elsif (@$entries) {
                (my $legacy_path = $lotus_tempDir) =~ s{[\\/]+$}{};
                my $backup = $legacy_path . ".lotus3-legacy-backup-" . strftime("%Y%m%d_%H%M%S", localtime) . "-$$";
                my $suffix = 0;
                while (-e $backup) { $suffix++; $backup = $legacy_path . ".lotus3-legacy-backup-" . strftime("%Y%m%d_%H%M%S", localtime) . "-$$-$suffix"; }
                rename($legacy_path, $backup)
                    or die "Could not preserve legacy temporary directory $legacy_path as $backup: $!\n";
                printL("Recognized a marker-less temporary directory from an older LotuS run, but it also contained unrecognized entries. The complete directory was preserved at $backup before creating a clean temporary directory.\n", "w");
            }
        }
    }
    ensure_dir($lotus_tempDir);
    my $expected = abs_path($outdir) // File::Spec->rel2abs($outdir);
    atomic_write_text($tempDirCreatedMarker, "LotuS3 temporary directory\nOutput: $expected\nPID: $$\n");
}

sub shell_quote {
    my ($s) = @_;
    return "''" unless defined $s && length $s;
    $s =~ s/'/'\\''/g;
    return "'$s'";
}

sub split_shell_commands {
    my ($cmd) = @_;
    my @cmds;
    my $buf = "";
    my $quote = "";
    my $esc = 0;
    for my $ch (split //, $cmd) {
        if ($esc) { $buf .= $ch; $esc = 0; next; }
        if ($ch eq "\\") { $buf .= $ch; $esc = 1; next; }
        if ($quote) {
            $quote = "" if $ch eq $quote;
            $buf .= $ch;
            next;
        }
        if ($ch eq "'" || $ch eq '"') { $quote = $ch; $buf .= $ch; next; }
        if ($ch eq ";") { push @cmds, $buf if $buf =~ /\S/; $buf = ""; next; }
        $buf .= $ch;
    }
    push @cmds, $buf if $buf =~ /\S/;
    return @cmds;
}

sub systemL {
    my ($cmdF, $descr, $throwWarn) = @_;
    $descr //= "";
    $throwWarn = 1 unless defined $throwWarn;

    my $retStat = 0;
    my @cmds = split_shell_commands($cmdF);
    foreach my $subcmd (@cmds) {
        $subcmd =~ s/^\s+|\s+$//g;
        next if $subcmd eq "";
        print("[cmd] $subcmd\n") if ($verbosity > 2);
        print cmdLOG "[cmd] $subcmd\n" if defined fileno(cmdLOG);

        my $exec_cmd = $subcmd;
        if ($verbosity < 2 && $subcmd !~ /(?:^|\s)(?:>|2>|&>|\|)/) {
            $exec_cmd .= " >> " . shell_quote($progOutPut) . " 2>&1";
        }

        if ($dryRun) {
            print cmdLOG "[dry-run] $exec_cmd\n" if defined fileno(cmdLOG);
            next;
        }
        my $stat = system($exec_cmd);
        if ($stat != 0) {
            $retStat ||= $stat;
            if ($throwWarn) {
                my $msg = ($descr ne "" ? "$descr: " : "") . "CMD failed: $subcmd\nsee $progOutPut for error log\nExit status: $stat\n";
                print $msg;
                exit(9);
            }
        }
    }
    return $retStat;
}


sub splitFastas($ $) {
    my ( $inF, $num ) = @_;
    my $protN = cntFastaEntrs($inF);
    my $pPerFile = int( $protN / $num ) + 1;
    my $fCnt     = 0;
    my $curCnt   = 0;
    my @nFiles   = ("$inF.$fCnt");

    open I, "<$inF" or printL "Fatal: Can't open fasta file $inF\n", 59;
    open my $out, ">$inF.$fCnt"
      or printL "Fatal: Can't open output fasta file $inF.$fCnt\n", 59;
    while ( my $l = <I> ) {
        if ( $l =~ m/^>/ ) {
            $curCnt++;
            if ( $curCnt > $pPerFile ) {
                $fCnt++;
                close $out;
                open $out, ">$inF.$fCnt";
                push( @nFiles, "$inF.$fCnt" );
                $curCnt = 0;
            }
        }
        print $out $l;
    }
    close I;
    close $out;
    return \@nFiles;
}

sub extractFastas($ $ $) {
    my ( $in, $hr, $addSize ) = @_;
    my %tars = %{$hr};
    my %fasSubs;
    my $hd = "";
    open I, "<$in" or printL "Fatal: Can't open fasta file $in\n", 59;
    my $use = 0;
    while ( my $l = <I> ) {
        chomp $l;
        if ( $l =~ m/^>/ ) {
            $use = 0;
			my ($parsed_hd) = $l =~ m/^>(\S+)/;
			die "Empty FASTA identifier in $in\n" unless defined $parsed_hd;
			$hd = $parsed_hd;
            if ( exists( $tars{$hd} ) ) {
                if ($addSize) { $hd .= ";size=" . $tars{$hd} . ";"; }
                $use = 1;
                $fasSubs{$hd} = "";
            }
            next;
        }
        $fasSubs{$hd} .= $l if ($use);
    }
    close I;
    return \%fasSubs;
}

sub combine($ $) {
    my ( $fadd, $freal ) = @_;
    if ( $osname eq 'MSWin32' ) {
        systemL("type $fadd  $freal > $freal");
    }
    else {
        systemL("cat $fadd >> $freal");
    }
    unlink("$fadd");
}



sub prefix_find($){
	my ($ar) = @_;
	my @rds = @{$ar}; my @newRds = @rds;
	return (\@newRds, "") unless @rds;
	my $first = $rds[0]; 
	for (my $i=0;$i<@rds; $i++){
		my $second = $rds[$i];
		my ($common) = "$first\0$second" =~ m/^(.*\/).*\0\1/s;
		$first = defined($common) ? $common : "";
		last if $first eq "";
	}
	
	print "$first common prefix\n";
	for (my $i=0; $i<@newRds; $i++){
		$newRds[$i] =~ s/^\Q$first\E// if $first ne "";
		$newRds[$i] .= "/" if ($newRds[$i] !~ m/\/$/ && length($newRds[$i] ) != 0 );
	}
	return (\@newRds,$first);
}


sub autoMap{
	my ($refDirs, $ofile) = @_;
	my $prefix = "SMPL";
	my $smpCnt = 0;
	my $pairedP = "2";#just set default
	my @paired = split /,/,$pairedP;

	if (@paired > 1 ){
		print "Looking for mix of paired and single input files\n";
	}elsif ($paired[0]==2){
		print "Looking for paired input files\n";
	} elsif ($paired[0]==1){
		print "Looking for single read input files\n";
	} else {
		die "Arg 2 has to be supplied and be either \"1\" or \"2\" (single / paired read input in dirs)\n";
	}
	#### regex search string
	my $rawFileSrchStr1 = '(R1_00\d|\.1|_1|\.R1)\.f[^\.]*[aq][\.gz]*$';
	my $rawFileSrchStr2 = '(R2_00\d|\.2|_2|\.R2)\.f[^\.]*[aq][\.gz]*$';
	my $rawSingSrchStr = '.f[^\.]*[aq][\.gz]*$';

	my $map = "#SampleID	fastqFile\n";
	my @preRDs = split(/,/,$refDirs);
	if (@preRDs > 1 && @paired == 1){ #extend to full length
		for (my $i=1;$i<@preRDs;$i++){
			$paired[$i] = $paired[0];
		}
	}
	my ($arRDs,$pathPre) = prefix_find(\@preRDs);
	my @RDs = @{$arRDs};
	my $cnt=0;
	my $paired=2;
	foreach my $RD ( @RDs ){
		#print "DIR: $RD\n";
		opendir(DIR, "$pathPre/$RD") or die $!;
		my @pa2 =(); 
		my @pa1 = ();
		if ($paired == 2){
			@pa2 = sort ( grep { /$rawFileSrchStr2/ && -e "$pathPre/$RD/$_" } readdir(DIR) );
            rewinddir DIR;
			@pa1 = sort ( grep { /$rawFileSrchStr1/  && -e "$pathPre/$RD/$_"} readdir(DIR) );
			#fix reads double assigned, always assume 2nd is correct
			if (@pa1 != @pa2){
				my %h;
				@h{(@pa2)} = undef;
				@pa1 = grep {not exists $h{$_}} @pa1;
			}
			if (not @pa1 or @pa1 != @pa2){
				$paired=1;
			}
		}
		
		#in case things are not matching up.. go for single reads
		if ($paired == 1){
            rewinddir DIR;
			@pa1 = sort ( grep { /$rawSingSrchStr/  && -e "$pathPre/$RD/$_"} readdir(DIR) );
		}
		close(DIR);

		die "unequal read pairs!: ".@pa1 .",". @pa2."\n" if (@pa1 != @pa2 && $paired == 2);
		print "Found ".@pa1." samples in dir $RD\n";
		print "Assuming unpaired reads, as can not find signature for pair 2 files\n" if (@pa2 == 0 && @pa1 >0 && $paired == 2);
		#add to map
		foreach (my $i=0; $i< @pa1; $i++){
			if (@pa2 > 0){
				$map .= $prefix.$smpCnt."\t".$RD."".$pa1[$i].",".$RD."".$pa2[$i]."\n";
			} else {
				$map .= $prefix.$smpCnt."\t".$RD."".$pa1[$i]."\n";
			}
			$smpCnt ++;
		}
		$cnt++;
		
	}
	open O,">$ofile" or die "Can't open $ofile\n";
	print O $map;
	close O;

	print "Map is $ofile\n";
	print "Please check that all files required are present in map $ofile.\n";
	print "==========================\nTo start analysis:\nlotus3 -m $ofile -i $pathPre/ -o [outdir] [further parameters if desired]\n==========================\n";
	exit(0);

}

sub usearchDerepSort($ ) {
    my ($filtered) = @_;
    my $outputLab = "-output";
    if ( $usearchVer >= 8 && $VSused == 0 ) { $outputLab = "-fastaout"; }

    printL(
"\n =========================================================================\n Dereplicate exact sub-sequences & sort (usearch).\n ",
        0
    );
    $cmd = "$VSBin -derep_fulllength $filtered $outputLab $lotus_tempDir/derep.fa -uc $lotus_tempDir/derep.uc -log $logDir/derep.log -sizeout -threads $uthreads;";

    #die($cmd);
    if ( systemL($cmd) != 0 ) { printL "Failed dereplication\n", 1; }

    my $dcnt          = 1;
    my $bigDerepCnt   = 0;
    my @lotsFiles     = ($filtered);
    my @subDerepFa    = ("$lotus_tempDir/derep.fa");    #my @subDerepUC = ("$lotus_tempDir/derep.uc");
    my @subDerepFaTmp = ();
    while ( -f $filtered . "." . $dcnt ) {
        if ( $dcnt == 1 ) { @subDerepFaTmp = @subDerepFa; @subDerepFa = (); }
        push( @lotsFiles,     $filtered . "." . $dcnt );
        push( @subDerepFaTmp, "$lotus_tempDir/derep.fa.$dcnt" )
          ;    #push(@subDerepUC,"$lotus_tempDir/derep.uc.$dcnt");
        $cmd = "$VSBin -derep_fulllength $filtered.$dcnt $outputLab $subDerepFaTmp[-1] -sizeout -threads $uthreads;"
          ;    #-uc $lotus_tempDir/derep.uc -log $logDir/derep.log
               #die $cmd;
        if ( systemL($cmd) != 0 ) { printL "Failed dereplication\n", 1; }
        if ( -f $filterOutAdd . "." . $dcnt ) {

            #Combining low qual reads..
            combine( $filterOutAdd . "." . $dcnt, $filterOutAdd );
        }
        if ( ( $dcnt + 1 ) % 10 == 0 || !-f $filtered . "." . ( $dcnt + 1 ) )
        {      #intermediary merge.. too big otherwise
            my $firstF = shift(@subDerepFaTmp);

            #print join(" ",@subDerepFaTmp)."\n";
            my $pid =
              open( CMD,
                "| cat " . join( " ", @subDerepFaTmp ) . " >> $firstF" )
              || printL "Merge of derep subfiles failed.\n", 1;
            defined($pid) || printL( "Cannot fork derep of subfiles.\n", 1 );
            close CMD;
            foreach (@subDerepFaTmp) { unlink; }
            @subDerepFaTmp = ();

            my $dereOut = "$lotus_tempDir/derep.inter.$bigDerepCnt.temp";
            $cmd = "$VSBin -derep_fulllength $firstF $outputLab $dereOut -uc $lotus_tempDir/derep.uc -log $logDir/derep.log -sizeout -threads $uthreads;";
            if ( systemL($cmd) != 0 ) {
                printL "Failed intermediate dereplication\n", 1;
            }
            newUCSizes( $dereOut, "$lotus_tempDir/derep.uc" );

            #delete tmp files
            unlink("$lotus_tempDir/derep.uc");
            unlink("$firstF");
            push( @subDerepFa, $dereOut );
            $bigDerepCnt++;

            #consecutive bigger files
            if ( @subDerepFa > 1 ) {
                $firstF = shift(@subDerepFa);
                $pid    = open( CMD,
                    "| cat " . join( " ", @subDerepFa ) . " >> $firstF" );
                defined($pid)
                  || printL( "Cannot fork derep of subfiles.\n", 1 );
                close CMD || printL "Merge of derep subfiles failed.\n", 1;
                $cmd = "$VSBin -derep_fulllength $firstF $outputLab $lotus_tempDir/derep.post.temp -uc $lotus_tempDir/derep.uc -log $logDir/derep.log -sizeout -threads $uthreads;";
                print $cmd. "\n";
                systemL $cmd || printL "Derep Command Failed: \n$cmd\n", 1;
                newUCSizes( "$lotus_tempDir/derep.post.temp", "$lotus_tempDir/derep.uc" );
                foreach (@subDerepFa) { print $_. "\n"; unlink; }
                systemL("mv $lotus_tempDir/derep.post.temp $lotus_tempDir/derep.fa");
                unlink("$lotus_tempDir/derep.pre.temp");
                @subDerepFa = ("$lotus_tempDir/derep.fa");
            }
            elsif ( !-f $filtered . "." . ( $dcnt + 1 ) ) {
                systemL("mv $subDerepFa[0] $lotus_tempDir/derep.fa");
            }
        }
        $dcnt++;
    }
    my $dereplicate_minsizeX = $dereplicate_minsize;
	my ($simple_minsize) = $dereplicate_minsizeX =~ m/^(\d+)/;
	die "Invalid dereplication minimum size '$dereplicate_minsize'\n" unless defined $simple_minsize;
	$dereplicate_minsizeX = $simple_minsize;
    printL "Reset derep min to $dereplicate_minsizeX, as u/vsearch does not support more complex options\n","w";

    #dereplicate_minsize is 2 by default
    $cmd = "$VSBin -sortbysize  $lotus_tempDir/derep.fa $outputLab $lotus_tempDir/derep.fas -minsize $dereplicate_minsizeX -log $logDir/sortbysize.log;";
    if ( systemL($cmd) != 0 ) { exit(1); }
    unlink("$lotus_tempDir/derep.fa");
